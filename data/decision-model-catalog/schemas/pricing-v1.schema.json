{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tnunamak/minnows/data/decision-model-catalog/schemas/pricing-v1.schema.json",
  "title": "decision-model-catalog pricing table v1",
  "description": "tokensmash-compatible for per-token rows (four rate fields). Also expresses free output, per-request/per-decision fees and raw vendor units (e.g. Workers AI neurons) kept next to a sourced USD conversion. Per-token price is NOT cost per decision; see performance rows with unit usd_per_decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "kind",
    "agent",
    "retrieved_at",
    "source_urls",
    "models",
    "match"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$",
      "description": "Stable table id, e.g. anthropic-api-2026-07"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "api_usd"
      ],
      "description": "api_usd = dollars; per-token rates are per 1M tokens"
    },
    "agent": {
      "type": "string",
      "enum": [
        "other"
      ],
      "description": "Always 'other' for decision models (kept for tokensmash shape compatibility)"
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "notes": {
      "type": "string"
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "billing_basis"
        ],
        "properties": {
          "fresh_input_per_m": {
            "type": "number",
            "minimum": 0
          },
          "cache_read_per_m": {
            "type": "number",
            "minimum": 0
          },
          "cache_write_per_m": {
            "type": "number",
            "minimum": 0
          },
          "output_per_m": {
            "type": "number",
            "minimum": 0
          },
          "valid_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "valid_until": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "post_valid_until": {
            "type": "object",
            "required": [
              "fresh_input_per_m",
              "cache_read_per_m",
              "cache_write_per_m",
              "output_per_m"
            ],
            "additionalProperties": false,
            "properties": {
              "fresh_input_per_m": {
                "type": "number",
                "minimum": 0
              },
              "cache_read_per_m": {
                "type": "number",
                "minimum": 0
              },
              "cache_write_per_m": {
                "type": "number",
                "minimum": 0
              },
              "output_per_m": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "billing_basis": {
            "type": "string",
            "enum": [
              "per_token",
              "per_request",
              "per_decision",
              "raw_units",
              "free",
              "self_host"
            ]
          },
          "output_free": {
            "type": "boolean",
            "description": "Vendor does not bill output tokens; output_per_m must then be 0 or absent"
          },
          "per_request_usd": {
            "type": "number",
            "minimum": 0
          },
          "min_request_usd": {
            "type": "number",
            "minimum": 0
          },
          "per_decision_usd": {
            "type": "number",
            "minimum": 0
          },
          "raw_units": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit"
            ],
            "description": "Vendor's native billing unit, verbatim (e.g. neurons)",
            "properties": {
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "input_per_m": {
                "type": "number",
                "minimum": 0
              },
              "output_per_m": {
                "type": "number",
                "minimum": 0
              },
              "per_request": {
                "type": "number",
                "minimum": 0
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "usd_conversion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "usd_per_unit",
              "source_id"
            ],
            "description": "USD per raw unit and where that conversion comes from; USD rates next to raw_units require this",
            "properties": {
              "usd_per_unit": {
                "type": "number",
                "minimum": 0
              },
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+$"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "caveat_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]+$"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "billing_basis": {
                  "const": "per_token"
                }
              },
              "required": [
                "billing_basis"
              ]
            },
            "then": {
              "required": [
                "fresh_input_per_m",
                "cache_read_per_m",
                "cache_write_per_m",
                "output_per_m"
              ]
            }
          }
        ]
      }
    },
    "match": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern",
          "model"
        ],
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "family_default": {
            "type": "boolean",
            "description": "True if this pattern maps a family name to a chosen default SKU (policy-ish; consumers may refuse)"
          }
        }
      },
      "description": "Ordered substring match rules; first win. Each model must exist in models."
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      },
      "description": "Ids from SOURCES.json that back this pricing table"
    },
    "role": {
      "type": "string",
      "enum": [
        "operational",
        "reference"
      ],
      "description": "operational = used by agent surfaces; reference = priced but not wired into ops/adapters"
    }
  }
}
