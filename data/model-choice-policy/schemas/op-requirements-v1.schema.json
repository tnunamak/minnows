{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tnunamak/minnows/data/model-choice-policy/schemas/op-requirements-v1.schema.json",
  "title": "model-choice-policy op-requirements v1",
  "description": "Task-family and missed-problem cost inputs for scripts/recommend_ops.py. Cross-file checks run in the recommender.",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "status",
    "generated_at",
    "catalog_ref",
    "defaults",
    "ops",
    "task_families"
  ],
  "additionalProperties": false,
  "$defs": {
    "provider": {
      "enum": [
        "claude",
        "codex",
        "grok",
        "antigravity",
        "qwen",
        "deepseek"
      ]
    },
    "effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "grade": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "const": "model-choice-op-requirements"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "REVIEWED"
      ]
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "catalog_ref": {
      "type": "string",
      "pattern": "^data-model-catalog-v\\d+\\.\\d+\\.\\d+$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaults": {
      "type": "object",
      "required": [
        "allowed_providers",
        "allowed_efforts",
        "cost_basis",
        "min_evidence_grade",
        "source_weights",
        "vendor_cross_vendor_factor",
        "attempt_overhead_usd",
        "failure_detection_probability"
      ],
      "additionalProperties": false,
      "properties": {
        "allowed_providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provider"
          },
          "minItems": 1
        },
        "allowed_efforts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effort"
          },
          "minItems": 1
        },
        "cost_basis": {
          "const": "usd_per_task"
        },
        "min_evidence_grade": {
          "$ref": "#/$defs/grade"
        },
        "provider_restrictions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/provider"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "source_weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "vendor_cross_vendor_factor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attempt_overhead_usd": {
          "type": "number",
          "minimum": 0
        },
        "failure_detection_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lane_scoped_freshness": {
          "type": "boolean"
        },
        "policy_horizon_days": {
          "type": "integer",
          "minimum": 1
        },
        "price_as_of": {
          "type": "string",
          "format": "date"
        },
        "majority_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "high_confidence_groups": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "op",
          "status",
          "constraints",
          "cost_basis",
          "rationale",
          "silent_failure_cost_usd"
        ],
        "additionalProperties": false,
        "properties": {
          "op": {
            "type": "string"
          },
          "status": {
            "enum": [
              "DRAFT",
              "REVIEWED"
            ]
          },
          "allowed_providers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/provider"
            },
            "minItems": 1
          },
          "allowed_efforts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effort"
            },
            "minItems": 1
          },
          "effort_override_reason": {
            "type": "string",
            "minLength": 1
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(different_model_family_from|different_vendor_from):[a-z0-9.-]+$"
            }
          },
          "cost_basis": {
            "const": "usd_per_task"
          },
          "min_evidence_grade": {
            "$ref": "#/$defs/grade"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "constraint_decision": {
            "const": "OWNER_DECISION_PENDING"
          },
          "silent_failure_cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "attempt_overhead_usd": {
            "type": "number",
            "minimum": 0
          },
          "failure_detection_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "task_families": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "coding",
            "agentic",
            "research/browsing",
            "knowledge/factuality",
            "reasoning",
            "computer-use"
          ]
        }
      }
    }
  }
}
