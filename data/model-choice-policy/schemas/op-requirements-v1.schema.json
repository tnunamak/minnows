{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tnunamak/minnows/data/model-choice-policy/schemas/op-requirements-v1.schema.json",
  "title": "model-choice-policy op-requirements v1",
  "description": "Human-set slots per operating point, read by scripts/recommend_ops.py. Cross-file checks (op ids, metric ids, provider restrictions, constraint cycles) are done by the recommender at load time.",
  "type": "object",
  "required": ["id", "schema_version", "status", "generated_at", "catalog_ref", "defaults", "ops"],
  "additionalProperties": false,
  "$defs": {
    "provider": { "enum": ["claude", "codex", "grok"] },
    "effort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] },
    "grade": { "enum": ["A", "B", "C", "D"] },
    "bar": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": { "type": { "const": "frontier_best" } }
        },
        {
          "type": "object",
          "required": ["type", "points"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "within_points_of_best" },
            "points": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["type", "op"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "at_least_op" },
            "op": { "type": "string" }
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "model-choice-op-requirements" },
    "schema_version": { "const": 1 },
    "status": { "enum": ["DRAFT", "REVIEWED"] },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "catalog_ref": { "type": "string", "pattern": "^data-model-catalog-v\\d+\\.\\d+\\.\\d+$" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "defaults": {
      "type": "object",
      "required": ["allowed_providers", "allowed_efforts", "cost_basis", "min_evidence_grade", "source_weights", "vendor_cross_vendor_factor"],
      "additionalProperties": false,
      "properties": {
        "allowed_providers": { "type": "array", "items": { "$ref": "#/$defs/provider" }, "minItems": 1 },
        "allowed_efforts": { "type": "array", "items": { "$ref": "#/$defs/effort" }, "minItems": 1 },
        "cost_basis": { "const": "usd_per_task" },
        "min_evidence_grade": { "$ref": "#/$defs/grade" },
        "provider_restrictions": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/provider" },
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "source_weights": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "vendor_cross_vendor_factor": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "status", "evidence_metrics", "bar", "constraints", "cost_basis", "rationale"],
        "additionalProperties": false,
        "properties": {
          "op": { "type": "string" },
          "status": { "enum": ["DRAFT", "REVIEWED"] },
          "evidence_metrics": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "allowed_providers": { "type": "array", "items": { "$ref": "#/$defs/provider" }, "minItems": 1 },
          "allowed_efforts": { "type": "array", "items": { "$ref": "#/$defs/effort" }, "minItems": 1 },
          "effort_override_reason": { "type": "string", "minLength": 1 },
          "bar": { "$ref": "#/$defs/bar" },
          "constraints": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(different_model_family_from|different_vendor_from):[a-z0-9.-]+$" }
          },
          "cost_basis": { "const": "usd_per_task" },
          "min_evidence_grade": { "$ref": "#/$defs/grade" },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
