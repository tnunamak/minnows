{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guide-v1.schema.json",
  "title": "model-catalog README guide inputs",
  "description": "What the README option map shows. The renderer (scripts/render_model_catalog_charts.py) reads only this file and the rest of the pack.",
  "type": "object",
  "$defs": {
    "vendor_style": {
      "type": "object",
      "required": [
        "label",
        "light",
        "dark"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "light": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "dark": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    }
  },
  "required": [
    "id",
    "schema_version",
    "pools",
    "task_families",
    "noise_floor",
    "cost"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "tier_notes": {
      "type": "string"
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "providers",
          "surfaces",
          "tiers"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "models.json provider values billed to this quota pool"
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "capabilities surface ids to read effort levels from, first match wins"
          },
          "color_slot": {
            "type": "integer",
            "minimum": 1,
            "description": "categorical palette slot for this pool"
          },
          "tiers": {
            "type": "array",
            "description": "Cheapest tier first. The renderer shows the newest GA, unrestricted model in each tier.",
            "items": {
              "type": "object",
              "required": [
                "tier",
                "label",
                "summary",
                "source_id"
              ],
              "properties": {
                "tier": {
                  "type": "string",
                  "description": "models.json tier value"
                },
                "label": {
                  "type": "string"
                },
                "summary": {
                  "type": "string",
                  "maxLength": 44,
                  "description": "Short form of the vendor's own description of the tier"
                },
                "source_id": {
                  "type": "string",
                  "description": "SOURCES.json id for the summary"
                }
              }
            }
          }
        }
      }
    },
    "task_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "includes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "includes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "performance score row task_family values in this column group"
          }
        }
      }
    },
    "noise_floor": {
      "type": "object",
      "required": [
        "label",
        "source_ids",
        "by_unit"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "by_unit": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "by_metric": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "score_cost_unit",
        "price_kind",
        "price_header",
        "footer"
      ],
      "properties": {
        "score_cost_unit": {
          "type": "string",
          "description": "performance cost.unit used to decide which setting is cheaper"
        },
        "price_kind": {
          "type": "string",
          "description": "pricing document kind shown in the price column"
        },
        "price_header": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 2
        },
        "footer": {
          "type": "string"
        }
      }
    },
    "hero": {
      "type": "object",
      "description": "The cost-vs-intelligence chart at the top of the README: one metric, plotted against API cost per task, every vendor.",
      "required": [
        "title",
        "metric_id",
        "y_label",
        "credit",
        "cost_basis",
        "bridge",
        "featured",
        "providers",
        "other_providers",
        "notes"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "metric_id": {
          "type": "string",
          "description": "metrics.json id; pins one index version"
        },
        "y_label": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        },
        "cost_basis": {
          "type": "string",
          "description": "performance cost.basis to plot (cost.unit comes from cost.score_cost_unit)"
        },
        "exclude_groups_matching": {
          "type": "string",
          "description": "Regular expression; comparability groups that match are left out and named in the footnote"
        },
        "bridge": {
          "type": "object",
          "required": [
            "score_tolerance",
            "cost_ratio_tolerance"
          ],
          "properties": {
            "score_tolerance": {
              "type": "number",
              "minimum": 0
            },
            "cost_ratio_tolerance": {
              "type": "number",
              "minimum": 1,
              "description": "Largest allowed ratio between two snapshots' costs for one setting (higher / lower)"
            }
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "caveat_matches",
              "mark",
              "label",
              "note"
            ],
            "properties": {
              "caveat_matches": {
                "type": "string",
                "description": "Regular expression matched against the score row caveat"
              },
              "mark": {
                "type": "string",
                "maxLength": 2
              },
              "label": {
                "type": "string",
                "description": "Short key text next to the hollow dot"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "featured": {
          "type": "object",
          "required": [
            "newest_per_tier_providers",
            "statuses",
            "top_others",
            "include_frontier"
          ],
          "properties": {
            "newest_per_tier_providers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "statuses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "top_others": {
              "type": "integer",
              "minimum": 0
            },
            "include_frontier": {
              "type": "boolean"
            },
            "min_score": {
              "type": "number",
              "description": "Models whose best score is under this stay out of the featured chart (all-models chart only)"
            }
          }
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/vendor_style"
          }
        },
        "other_providers": {
          "$ref": "#/$defs/vendor_style"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "effort_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Optional short column labels for effort levels, e.g. medium -> med"
    },
    "score_display": {
      "type": "object",
      "description": "How to label score axes: percent or raw, by unit and by metric",
      "properties": {
        "by_unit": {
          "type": "object"
        },
        "by_metric": {
          "type": "object"
        }
      }
    }
  }
}
