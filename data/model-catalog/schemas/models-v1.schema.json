{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tnunamak/minnows/data/model-catalog/schemas/models-v1.schema.json",
  "title": "model-catalog L0 model registry v1",
  "description": "Canonical model ids + aliases — the join key for pricing, performance, and capabilities. Documentation contract for scripts/validate_data_pack.py's stdlib checks (not run under --require-jsonschema).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "schema_version",
    "generated_at",
    "models"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "const": "model-catalog-models"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "provider",
          "family",
          "status",
          "aliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai",
              "xai",
              "google",
              "alibaba",
              "deepseek",
              "other"
            ]
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "ga",
              "preview",
              "historical",
              "third_party_board_only"
            ]
          },
          "tier": {
            "type": "string",
            "description": "Capability tier. Provider-specific: OpenAI astra/sol/terra/luna/pro/mini/nano/codex/base; Anthropic fable/mythos/opus/sonnet/haiku; Google pro/flash/flash-lite/deep-think/specialized/managed-agent; xAI flagship/build-agent.",
            "enum": [
              "astra",
              "sol",
              "terra",
              "luna",
              "pro",
              "mini",
              "nano",
              "codex",
              "base",
              "fable",
              "mythos",
              "opus",
              "sonnet",
              "haiku",
              "flash",
              "flash-lite",
              "deep-think",
              "specialized",
              "managed-agent",
              "flagship",
              "build-agent",
              "coder",
              "open-weight",
              "glm",
              "max",
              "plus"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          },
          "access": {
            "type": "string",
            "enum": [
              "general",
              "restricted"
            ],
            "description": "restricted = trusted-access only; never a routing candidate"
          },
          "effort_parameter": {
            "type": "boolean",
            "description": "false = the model accepts no effort parameter (route with no effort flag)"
          },
          "released": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "ISO release date stated by the cited primary source."
          },
          "release_source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$",
            "description": "Primary SOURCES.json id that states the released date."
          }
        }
      }
    },
    "resolution_rules": {
      "type": "object"
    }
  }
}
