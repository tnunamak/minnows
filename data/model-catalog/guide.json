          "label": "Opus",
          "summary": "Long agentic coding and knowledge work",
          "source_id": "anthropic-models-overview-2026-09-22"
        },
        {
          "tier": "fable",
          "label": "Fable",
          "summary": "Demanding reasoning, long-horizon agents",
          "source_id": "anthropic-models-overview-2026-09-22"
        }
      ]
    },
    {
      "id": "codex",
      "label": "Codex",
      "providers": [
