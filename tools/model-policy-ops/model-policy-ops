#!/usr/bin/env python3
"""Check and read the model-choice-policy data pack."""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path


REPO = Path(__file__).resolve().parents[2]
PACK = REPO / "data" / "model-choice-policy"
OPERATING_POINTS = PACK / "operating-points.json"
sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from experimental_routes import check_experimental_free_routes
import quota_bands


def select_policy(explicit_path):
    if explicit_path is not None:
        return explicit_path
    if os.environ.get("DATA_PACKS_HOME"):
        return Path(os.environ["DATA_PACKS_HOME"]) / "model-choice-policy/operating-points.json"
    return OPERATING_POINTS


def load_policy(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise SystemExit(f"missing policy file: {path}") from None


BASES = ("primary", "task_benchmark_prior", "unvalidated")
PRIOR_KEYS = ("board", "board_cited_for_op", "effort_matched", "harness_matched", "note")
PROOF_CLASSES = ("oracle", "judged", "none")
INDEPENDENCE_LEVELS = ("vendor", "family", "model")
LINEAGE_FIELDS = ("family", "tier")


def check_candidates(op: dict, where: str) -> list[str]:
    """Validate the optional `candidates` list: the alternates to `expands_to`, which is always the primary.

    An absent list is valid and means no alternates. Nothing here compares a candidate with `expands_to`.
    """
    if "candidates" not in op:
        return []
    rows = op["candidates"]
    if not isinstance(rows, list) or not rows:
        return [f"{where}: candidates must be a non-empty list"]
    errors: list[str] = []
    for j, row in enumerate(rows):
        at = f"{where}.candidates[{j}]"
        if not isinstance(row, dict):
            errors.append(f"{at}: must be an object")
            continue
        for key in ("provider", "model", "effort"):
            if not isinstance(row.get(key), str) or not row[key]:
                errors.append(f"{at}: missing {key}")
        if row.get("basis") not in BASES[1:]:
            errors.append(f"{at}: basis must be task_benchmark_prior or unvalidated")
        for key in ("evidence_refs", "known_gaps"):
            if key in row and not (isinstance(row[key], list) and all(isinstance(v, str) for v in row[key])):
                errors.append(f"{at}: {key} must be a list of strings")
        prior = row.get("prior")
        if row.get("basis") == "task_benchmark_prior":
            if not isinstance(prior, dict) or set(prior) != set(PRIOR_KEYS):
                errors.append(f"{at}: task_benchmark_prior needs prior with exactly {', '.join(PRIOR_KEYS)}")
            elif not (isinstance(prior["board"], str) and prior["board"] and isinstance(prior["note"], str)
                      and prior["board_cited_for_op"] is True and prior["effort_matched"] is True
                      and isinstance(prior["harness_matched"], bool)):
                errors.append(f"{at}: prior needs a board, board_cited_for_op true, effort_matched true and a boolean harness_matched")
        elif prior is not None:
            errors.append(f"{at}: prior is only for basis task_benchmark_prior")
        requires = row.get("requires")
        if requires is not None:
            if not isinstance(requires, dict) or set(requires) != {"proof_class"}:
                errors.append(f"{at}: requires takes only proof_class")
            elif not (isinstance(requires["proof_class"], list) and requires["proof_class"] and set(requires["proof_class"]) <= set(PROOF_CLASSES)):
                errors.append(f"{at}: requires.proof_class must be a non-empty list of {', '.join(PROOF_CLASSES)}")
    return errors


def check_quota_substitution(value, present: bool) -> list[str]:
    """Validate `routing.quota_substitution`: 0 < release_projected_pct < activate_projected_pct <= 200. Absent means off."""
    if not present:
        return []
    keys = ("activate_projected_pct", "release_projected_pct")
    if not isinstance(value, dict) or set(value) != set(keys):
        return [f"routing.quota_substitution must be an object with exactly {', '.join(keys)}"]
    if not all(type(value[key]) in (int, float) for key in keys):
        return [f"routing.quota_substitution: {' and '.join(keys)} must be numbers"]
    if not 0 < value["release_projected_pct"] < value["activate_projected_pct"] <= 200:
        return ["routing.quota_substitution needs 0 < release_projected_pct < activate_projected_pct <= 200"]
    return []


def check_routing(routing) -> list[str]:
    """Validate the optional pack `routing` object. Each field is optional; a present field must be well formed."""
    if routing is None:
        return []
    if not isinstance(routing, dict):
        return ["routing must be an object"]
    errors: list[str] = []
    unknown = sorted(set(routing) - {"pace_windows", "failure_lookback_minutes", "failure_demote_count", "review_task_families", "independence_default", "directive_max_days", "lineage_key", "observation_max_age_hours", "observation_window_days", "quota_substitution", "quota_bands"})
    if unknown:
        errors.append(f"routing: unknown keys {', '.join(unknown)}")
    for key in ("pace_windows", "review_task_families"):
        if key in routing and not (isinstance(routing[key], list) and all(isinstance(v, str) and v for v in routing[key])):
            errors.append(f"routing.{key} must be a list of strings")
    for key in ("failure_lookback_minutes", "failure_demote_count", "directive_max_days", "observation_max_age_hours", "observation_window_days"):
        if key in routing and not (type(routing[key]) is int and routing[key] > 0):
            errors.append(f"routing.{key} must be a positive integer")
    if "independence_default" in routing and routing["independence_default"] not in INDEPENDENCE_LEVELS:
        errors.append(f"routing.independence_default must be one of {', '.join(INDEPENDENCE_LEVELS)}")
    errors.extend(check_quota_substitution(routing.get("quota_substitution"), "quota_substitution" in routing))
    errors.extend(quota_bands.check(routing.get("quota_bands"), "quota_bands" in routing))
    lineage = routing.get("lineage_key")
    if "lineage_key" in routing and not (isinstance(lineage, dict) and lineage and all(
            isinstance(k, str) and k and v in LINEAGE_FIELDS for k, v in lineage.items())):
        errors.append(f"routing.lineage_key must map each provider to one of {', '.join(LINEAGE_FIELDS)}")
    return errors


def check_policy(policy: dict) -> list[str]:
    errors: list[str] = []
    seen: set[str] = set()
    for i, op in enumerate(policy.get("operating_points", [])):
        where = f"operating_points[{i}]"
        op_id = op.get("id")
        if not op_id:
            errors.append(f"{where}: missing id")
        elif op_id in seen:
            errors.append(f"{where}: duplicate id {op_id}")
        else:
            seen.add(op_id)
        expands_to = op.get("expands_to")
        if not isinstance(expands_to, dict):
            errors.append(f"{where}: missing expands_to")
            continue
        for key in ("provider", "model", "effort"):
            if not expands_to.get(key):
                errors.append(f"{where}: missing expands_to.{key}")
        errors.extend(check_candidates(op, where))
    errors.extend(check_routing(policy.get("routing")))
    errors.extend(check_experimental_free_routes(policy.get("experimental_free_routes")))
    if not policy.get("catalog_ref"):
        errors.append("missing catalog_ref")
    if not policy.get("policy_version"):
        errors.append("missing policy_version")
    return errors


def print_list(policy: dict) -> None:
    rows = []
    for op in policy.get("operating_points", []):
        expands_to = op["expands_to"]
        rows.append(
            (
                op["id"],
                op.get("task_family", ""),
                op.get("constraint_family", ""),
                expands_to.get("provider", ""),
                expands_to.get("model", ""),
                expands_to.get("effort", ""),
            )
        )
    headers = ("op", "task", "constraint", "provider", "model", "effort")
    widths = [
        max(len(str(row[i])) for row in (headers, *rows))
        for i in range(len(headers))
    ]
    print(" | ".join(headers[i].ljust(widths[i]) for i in range(len(headers))))
    print("-+-".join("-" * width for width in widths))
    for row in rows:
        print(" | ".join(str(row[i]).ljust(widths[i]) for i in range(len(row))))


def print_show(policy: dict, op_id: str) -> int:
    for op in policy.get("operating_points", []):
        if op.get("id") == op_id:
            print(json.dumps(op, indent=2, sort_keys=True))
            return 0
    print(f"unknown op: {op_id}", file=sys.stderr)
    return 1


def brief_decision(result: dict, receipts: Path, *, recorded: bool) -> dict:
    """Project an executed receipt for printing only; never mutate it or read/write state."""
    routing = result.get("routing") or {}
    selection = result.get("selection") or {}
    chosen = routing.get("chosen") or {}
    final = routing.get("final") or {}
    arm = final.get("arm", selection.get("arm"))
    destination = result.get("destination", "model")
    simulation = "simulation" in result

    selected = {
        "arm": arm,
        "account": (result.get("target") or {}).get("providerInstanceId") if destination == "model" else final.get("account"),
        "state": selection.get("state"),
        "overridden": final.get("overridden"),
        # The receipt does not attest a final basis, including for resolve.
        "final_basis": None,
        "routed_basis": chosen.get("basis") if arm is not None and arm == chosen.get("arm") else None,
        "routed_selection_basis": chosen.get("selection_basis") if arm is not None and arm == chosen.get("arm") else None,
    }
    routed = {key: chosen.get(key) for key in ("arm", "basis", "selection_basis")} if chosen else None

    def excerpt(value):
        encoded = json.dumps(value, sort_keys=True, separators=(",", ":"))
        return value if len(encoded) <= 512 else {"preview": encoded[:512], "truncated": True}

    notes = {}
    source_notes = routing.get("calibration_notes") or {}
    # Small actionable notes stay structured; bulky history is counted and excerpted.
    for key in sorted(source_notes)[:8]:
        value = source_notes[key]
        if isinstance(value, list) and (len(value) > 3 or len(json.dumps(value)) > 1024):
            notes[key] = {"count": len(value), "items": [excerpt(item) for item in value[:3]],
                          "omitted": max(0, len(value) - 3)}
        else:
            notes[key] = excerpt(value)
    if len(source_notes) > 8:
        notes["omitted_fields"] = len(source_notes) - 8

    stored = not simulation and (recorded or result.get("replayed") is True)
    receipt = {"stored": stored, "decision_id": result.get("decision_id")}
    if stored:
        receipt.update({
            "path": str(receipts.absolute()), "format": "jsonl",
            "replay": "Read the JSONL row matching decision_id for the exact stored receipt; "
                      "or repeat identical caller-intent arguments with --json (instead of --brief) to replay.",
        })
    else:
        receipt.update({
            "reason": "simulation" if simulation else "not_recorded",
            "full_output": "No stored receipt for this evaluation. Rerun with --json for full output; inputs may change.",
        })

    choice = result.get("choice") or {}
    waiting = choice.get("warning")
    dispatch = result.get("dispatch")
    if simulation or waiting or "waiting" in result:
        dispatch = None
    elif dispatch is None and result.get("target") is not None and result.get("launch_ready") is True:
        dispatch = {"clientRequestId": result.get("decision_id"), "mode": "async"}

    brief = {
        "decision_id": result.get("decision_id"),
        "target": result.get("target"),
        "destination": destination,
        "launch_ready": result.get("launch_ready", False),
        "launch_readiness_basis": result.get("launch_readiness_basis"),
        "dispatch": dispatch,
        "judgment_required": routing.get("judgment_required"),
        "judgment_reasons": routing.get("judgment_reasons", []),
        "selected": selected if destination == "model" else None,
        "calibration_notes": notes,
        "receipt": receipt,
        "replayed": result.get("replayed", False),
    }
    if waiting:
        brief["waiting"] = {"state": "selected_waiting", "assertion": "caller_claim", "warning": waiting}
    elif "waiting" in result:
        brief["waiting"] = result["waiting"]
    if "data_policy" in result:
        brief["data_policy"] = result["data_policy"]
    if destination == "model":
        brief["routed"] = routed
    else:
        # These arms describe the model fallback, not the chosen destination.
        brief["model_fallback"] = {"selected": selected, "routed": routed}
    if "destination_offer" in result:
        brief["destination_offer"] = {
            key: value for key, value in result["destination_offer"].items() if key != "capacity"
        }
    for key in ("simulation", "simulated_target", "historical_non_actionable"):
        if key in result:
            brief[key] = result[key]
    return brief


def arm_text(arm, account=None):
    if not arm:
        return "none"
    return f"{arm.get('provider')}/{arm.get('model')}/{arm.get('effort')}" + (f"@{account}" if account else "")


def line_reason(result: dict) -> str:
    """One short sentence: what was chosen and why, and why a destination was not used. Print only."""
    routing = result.get("routing") or {}
    block = routing.get("destination") or {}
    if result.get("historical_non_actionable") is True:
        return "historical typed destination; re-route for current evidence; do not dispatch"
    if result.get("destination") and result["destination"] != "model":
        state = block.get("target_state")
        return f"destination {result['destination']} has capacity" + (f"; target {state}" if state else "; submit by hand")
    if routing:
        chosen, final = routing.get("chosen") or {}, routing.get("final") or {}
        text = f"{chosen.get('basis') or 'unranked'} candidate {chosen.get('candidate')} {arm_text(chosen.get('arm'), chosen.get('instance'))}"
        if final.get("overridden"):
            text += f"; override to {arm_text(final.get('arm'), final.get('account'))}"
    else:
        selection = result.get("selection") or {}
        text = f"explicit resolution ({selection.get('state')}) {arm_text(selection.get('arm'))}"
    found = block.get("fallback")
    if found:
        text += f"; {found.get('destination')} not used: {found.get('source')} {','.join(found.get('reasons') or [])}"
    elif block.get("not_eligible"):
        text += "; " + ", ".join(f"{row['name']} not eligible: {row['reason']}" for row in block["not_eligible"])
    elif block.get("not_considered"):
        text += f"; no destination: {block['not_considered']}"
    elif result.get("destination_skip"):
        text += "; destinations not consulted (resolve)"
    return text


def line_decision(result: dict, receipts: Path, *, recorded: bool) -> dict:
    """The default route/resolve output: one small line with what a caller needs to dispatch. Full record: --json."""
    brief = brief_decision(result, receipts, recorded=recorded)
    line = {key: brief[key] for key in ("decision_id", "target", "destination", "launch_ready", "dispatch", "judgment_required", "replayed")}
    line["judgment"] = [f"{r.get('applies_to', '?')}:{r.get('code')}" for r in brief.get("judgment_reasons") or []]
    line["reason"] = line_reason(result)
    line["receipt"] = brief["receipt"].get("path") if brief["receipt"]["stored"] else brief["receipt"].get("reason")
    for key in ("waiting", "data_policy", "simulation", "simulated_target", "historical_non_actionable"):
        if key in brief:
            line[key] = brief[key]
    if result.get("target") is None and "destination_offer" in brief:
        line["destination_offer"] = brief["destination_offer"]   # needed only for a hand submit
    line["more"] = "--brief for judgment details and notes; --json for the full receipt"
    return line


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--policy", type=Path, default=None)
    parser.add_argument("--user-policy", type=Path, default=None, help="per-user routing overlay; default ~/.config/model-policy/user-policy.json (a missing default means none; a missing named file is an error)")
    parser.add_argument("--no-user-policy", action="store_true", help="ignore the per-user overlay")
    parser.add_argument("command", nargs="?", choices=("check", "list", "show", "resolve", "route", "audit", "close", "followup", "directive", "calibrate", "observe", "report"))
    parser.add_argument("op", nargs="?")
    parser.add_argument("--brief", action="store_true", help="compact one-line JSON for route/resolve; full receipts are unchanged")
    from policy_decisions import add_arguments, execute
    import user_policy
    from runtime_sources import digest
    from decision_receipts import find_receipt
    add_arguments(parser)
    args = parser.parse_args()
    if args.brief and args.command not in ("route", "resolve"):
        parser.error("--brief applies to route and resolve only")
    if args.brief and args.json:
        parser.error("--brief and --json are mutually exclusive")
    args.policy = select_policy(args.policy)
    if args.no_user_policy and args.user_policy:
        parser.error("--user-policy and --no-user-policy are mutually exclusive")
    if (args.user_policy or args.no_user_policy) and (args.command or "check") not in ("route", "check"):
        parser.error("--user-policy and --no-user-policy apply to route and check only")

    def with_user_policy(pack):
        """The pack with the per-user overlay merged in (route and check only), checked as a whole. Raises ValueError."""
        args.pack_policy_sha256 = digest(pack)
        args.user_policy_info = None
        if args.no_user_policy or args.command not in ("route", "check", None):
            return pack
        if args.command == "route" and not args.now and args.decision_id and find_receipt(args.receipts, args.decision_id):
            return pack   # a stored receipt replays unchanged, so the current overlay is not read
        routing, args.user_policy_info = user_policy.read(args.user_policy or user_policy.default_path(),
                                                          required=args.user_policy is not None)
        if routing is None:
            return pack
        errors = check_routing(routing) + check_policy(merged := user_policy.merge(pack, routing))
        if errors:
            raise ValueError(f"user policy {args.user_policy_info['path']}: " + "; ".join(dict.fromkeys(errors)))
        return merged
    if args.target and args.command != "directive":
        parser.error(f"unrecognized arguments: {args.target}")
    if args.command in ("resolve", "route", "audit", "close", "followup", "directive", "calibrate", "observe", "report"):
        try:
            needs_policy = args.command in ("resolve", "route", "calibrate") or (args.command == "directive" and args.op in ("add", "list"))
            policy = load_policy(args.policy) if needs_policy else {}
            if needs_policy and not isinstance(policy, dict):
                raise ValueError('policy must be a JSON object')
            if needs_policy:
                errors = check_policy(policy)
                if errors:
                    raise ValueError("; ".join(errors))
                policy = with_user_policy(policy)
            errors = check_policy(policy) if needs_policy else []
            if errors:
                raise ValueError("; ".join(errors))
            result = execute(args, policy)
            if args.brief:
                print(json.dumps(brief_decision(result, args.receipts, recorded=args.record),
                                 separators=(",", ":"), sort_keys=True))
            elif args.command in ("route", "resolve") and not args.json:
                print(json.dumps(line_decision(result, args.receipts, recorded=args.record), separators=(",", ":"), sort_keys=True))
            else:
                print(json.dumps(result, indent=2, sort_keys=True))
            return 0
        except (ValueError, OSError, KeyError, TypeError) as error:
            print(f"FAIL {error}", file=sys.stderr)
            return 1

    policy = load_policy(args.policy)
    errors = check_policy(policy)
    if not errors:
        try:
            policy = with_user_policy(policy)
        except (ValueError, OSError) as error:
            errors = [str(error)]
    if errors:
        for error in errors:
            print(f"FAIL {error}", file=sys.stderr)
        return 1

    command = args.command or "check"
    if command == "list":
        print_list(policy)
    elif command == "show":
        if not args.op:
            parser.error("show requires an op id")
        return print_show(policy, args.op)
    else:
        print(
            f"PASS model-choice-policy {policy['policy_version']} "
            f"({len(policy.get('operating_points', []))} operating points)"
            + (f" + user policy {args.user_policy_info['path']}" if args.user_policy_info and command == "check" else "")
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
