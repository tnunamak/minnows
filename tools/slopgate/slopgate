#!/usr/bin/env python3
"""slopgate — measure and reduce AI slop in your own writing.

Two layers behind one command:

  1. deterministic (detector/, Node, free, no network) — syntactic frames,
     cadence statistics, tool artifacts, corpus-relative unearned names.
  2. semantic (semantic/, TypeSafe Jev, needs an API key) — the defects that
     have no syntactic signature: unearned benefit claims, restating the edit
     without the reason, teaching the reader things they already know,
     repeating yourself, editorial tone.

The layers are ordered cheapest-first. Layer 1 always runs. Layer 2 runs when a
key is available, and its absence is never an error: a missing key, a network
failure or a missing SDK prints a note to stderr and the run continues.

For an agent: run it on your draft, read the findings, rewrite, run it again
until it exits 0. Findings are ordered by severity, so fixing `high` first is
the efficient path.

  slopgate check --file DRAFT.md --kind doc
  git log -1 --format=%B | slopgate check --stdin --kind commit --json

Exit 1 if any finding survives, 0 if clean. Never exits nonzero for a tooling
problem, so a broken backend cannot block a workflow.

Calibrate it to your own taste:

  slopgate calibrate --human <dir-of-writing-you-like> --ai <dir-you-dont>

See semantic/corpus/README.md for how the shipped thresholds were derived and
why calibrating against a single generator is a trap.
"""
import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys

HERE = pathlib.Path(__file__).resolve().parent
DETECTOR = HERE / "detector" / "cli.mjs"
SEMANTIC = HERE / "semantic" / "jevgate.py"


def run_deterministic(text, kind):
    """Layer 1. Returns (findings, note). Never raises."""
    if not DETECTOR.exists():
        return [], None
    node = "node"
    try:
        r = subprocess.run(
            [node, str(DETECTOR), "check", "--stdin", "--json"],
            input=text, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        return [], f"deterministic layer unavailable ({type(e).__name__})"
    if not r.stdout.strip():
        return [], None
    try:
        return json.loads(r.stdout).get("findings", []), None
    except json.JSONDecodeError:
        return [], "deterministic layer returned unparseable output"


def run_semantic(text, kind):
    """Layer 2. Returns (findings, note). Never raises."""
    if not SEMANTIC.exists():
        return [], None
    if not os.environ.get("TYPESAFE_API_KEY"):
        return [], "semantic layer skipped (TYPESAFE_API_KEY not set)"
    # The SDK is a third-party dependency and this repo is otherwise
    # stdlib-only, so do not require it to be installed into the ambient
    # interpreter. Prefer `uv run --with`, which fetches it into an ephemeral
    # env, and fall back to the current interpreter when uv is absent.
    if shutil.which("uv"):
        cmd = ["uv", "run", "--quiet", "--with", "typesafe-sdk",
               "python", str(SEMANTIC)]
    else:
        cmd = [sys.executable, str(SEMANTIC)]
    try:
        r = subprocess.run(
            cmd + ["--stdin", "--kind", kind, "--json", "--quiet"],
            input=text, capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.SubprocessError) as e:
        return [], f"semantic layer unavailable ({type(e).__name__})"
    if not r.stdout.strip():
        return [], (r.stderr.strip()[:140] or None)
    try:
        return json.loads(r.stdout).get("findings", []), None
    except json.JSONDecodeError:
        return [], "semantic layer returned unparseable output"


def cmd_check(a):
    if a.file:
        try:
            text = pathlib.Path(a.file).read_text(encoding="utf-8", errors="replace")
        except OSError as e:
            print(f"slopgate: cannot read {a.file}: {e}", file=sys.stderr)
            return 0
    else:
        text = sys.stdin.read()

    if len(text.strip()) < 40:
        return 0

    findings, notes = [], []
    if not a.semantic_only:
        f, n = run_deterministic(text, a.kind)
        findings += f
        if n:
            notes.append(n)
    if not a.fast:
        f, n = run_semantic(text, a.kind)
        findings += f
        if n:
            notes.append(n)

    order = {"critical": 0, "high": 1, "medium": 2, "low": 3}
    findings.sort(key=lambda f: order.get(f.get("severity", "medium"), 2))

    if a.json:
        print(json.dumps({"findings": findings, "notes": notes}, indent=2))
    else:
        for n in notes:
            print(f"slopgate: {n}", file=sys.stderr)
        for f in findings:
            sev = f.get("severity", "medium")
            rule = f.get("rule", f.get("type", "?"))
            extra = ""
            if "probability" in f:
                extra = f" (p={f['probability']})"
            elif f.get("text"):
                extra = f" — {f['text'][:60]!r}"
            fix = f.get("suggestion", "")
            print(f"  [{sev}] {rule}{extra}" + (f" -> {fix}" if fix else ""))
        if not findings and not a.quiet:
            print("  clean")
    return 1 if findings else 0


def cmd_calibrate(a):
    script = HERE / "semantic" / "calibrate.py"
    if not script.exists():
        print("slopgate: calibrate.py missing", file=sys.stderr)
        return 0
    return subprocess.call(
        [sys.executable, str(script), "--human", a.human, "--ai", a.ai]
        + (["--emit"] if a.emit else []), cwd=str(HERE / "semantic"))


def cmd_mine(a):
    script = HERE / "semantic" / "mine_authorities.py"
    if not script.exists():
        print("slopgate: mine_authorities.py missing", file=sys.stderr)
        return 0
    return subprocess.call([sys.executable, str(script)], cwd=str(HERE / "semantic"))


def main():
    ap = argparse.ArgumentParser(prog="slopgate", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd")

    c = sub.add_parser("check", help="check a draft for slop")
    c.add_argument("--file")
    c.add_argument("--stdin", action="store_true")
    c.add_argument("--kind", default="doc", choices=["commit", "pr", "doc", "web"])
    c.add_argument("--json", action="store_true")
    c.add_argument("--fast", action="store_true",
                   help="deterministic layer only; no API call")
    c.add_argument("--semantic-only", action="store_true")
    c.add_argument("--quiet", action="store_true")
    c.set_defaults(fn=cmd_check)

    k = sub.add_parser("calibrate", help="derive thresholds from your own examples")
    k.add_argument("--human", required=True, help="dir of writing you consider good")
    k.add_argument("--ai", required=True, help="dir of writing you consider slop")
    k.add_argument("--emit", action="store_true")
    k.set_defaults(fn=cmd_calibrate)

    m = sub.add_parser("mine", help="harvest exemplar writing by named authorities")
    m.set_defaults(fn=cmd_mine)

    a = ap.parse_args()
    if not a.cmd:
        ap.print_help()
        return 0
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
