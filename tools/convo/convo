def _slug_for_project(p: Path, harness: str) -> str:
    """Best-effort human-readable project tag from a session path."""
    if harness == "claude":
        # parent dir is the slug e.g. -home-tnunamak-code-dotfiles
        return p.parent.name
    if harness == "qwen":
        # Qwen inserts a chats/ directory below its project slug.
        return p.parent.parent.name
    if harness == "gemini":
        # parent-of-parent is the project hash dir
        return p.parent.parent.name
    return ""  # codex: cwd comes from session_meta, resolved after load


def _candidate_may_match_project(harness: str, path: Path, flt: Optional[str]) -> bool:
    """Cheap prefilter so corrupt unrelated histories do not poison scoped commands."""
    if not flt:
        return True
    if harness == "claude":
        if "/" in flt:
            expected = cs.cwd_to_project_dir(flt) if cs else None
            return bool(expected) and path.parent == expected
        return flt.lower() in path.parent.name.lower()
    if harness == "qwen":
        project_dir = path.parent.parent
        if "/" in flt:
            expected_slug = str(Path(flt).expanduser().resolve()).replace("/", "-")
            return project_dir.name == expected_slug
        return flt.lower() in project_dir.name.lower()
    if harness == "codex":
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                for i, line in enumerate(fh):
                    if i >= 200:
                        break
                    try:
                        row = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if row.get("type") == "session_meta":
                        payload = row.get("payload", {})
                        cwd = payload.get("cwd") or payload.get("cwd_path")
                        if not cwd:
                            return False
                        if "/" in flt:
                            return str(Path(cwd).expanduser().resolve()) == str(Path(flt).expanduser().resolve())
                        return flt.lower() in cwd.lower()
        except OSError:
            return False
        return False
    return True


def discover(harnesses: list[str], project_filter: Optional[str],
             since_ts: Optional[float], limit: int, *,
             per_harness: bool = False) -> list[tuple[str, Path]]:
    """Return [(harness, path)] candidate session files, newest first, cheaply (stat only).

    Project filtering is intentionally NOT applied here: the authoritative project/cwd is
    only known after loading (Claude/Codex store it inside the file; the path slug is a
    lossy, dash-mangled encoding that won't substring-match a real path). discover() just
    bounds the candidate set by mtime/since so we don't load thousands of files; the real
    project filter runs post-load in load_sessions().
    """
    found: list[tuple[float, str, Path]] = []
    found_by_harness: dict[str, list[tuple[float, str, Path]]] = {}
    for h in harnesses:
        harness_found: list[tuple[float, str, Path]] = []
        cfg = HARNESSES[h]
        root: Path = cfg["root"]
        if not root.exists():
            continue
        paths = root.glob(cfg["glob"])
        if h == "claude" and project_filter and "/" in project_filter and cs:
            exact_dir = cs.cwd_to_project_dir(project_filter)
            paths = exact_dir.glob("*.jsonl") if exact_dir else []
        for p in paths:
            if cfg["skip"](p):
                continue
            try:
                st = p.stat()
            except OSError:
                continue
            if since_ts and st.st_mtime < since_ts:
                continue
            harness_found.append((st.st_mtime, h, p))
        found_by_harness[h] = harness_found
        found.extend(harness_found)

    # A cross-harness search must not let recent sessions from one harness push every
    # candidate from another harness outside the scan window. `list` and implicit
    # session selection intentionally remain globally newest-first; only grep needs a
    # fair per-harness candidate budget.
    if per_harness:
        found = []
        for harness_found in found_by_harness.values():
            harness_found.sort(reverse=True)
            cap = len(harness_found) if project_filter else max(limit * 2, 60)
            found.extend(harness_found[:cap])
    found.sort(reverse=True)
    # Project filtering happens after reading the authoritative cwd, so pre-capping
    # can erase every matching older session. Scan all candidates when scoped.
    cap = len(found) if project_filter else (len(found) if per_harness else max(limit * 2, 60))
    return [(h, p) for _, h, p in found[:cap]]


