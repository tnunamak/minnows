# Shared libraries are importable whether running from the repo (lib/ at repo root)
# or from a vendored skill folder (lib/ copied beside this script). See minnows README.
def _load_lib(name: str):
    import importlib.util
    here = Path(__file__).resolve().parent
    for cand in (here / "lib" / f"{name}.py",                 # vendored beside script
                 here.parent.parent / "lib" / f"{name}.py"):  # repo root lib/
        if cand.exists():
            spec = importlib.util.spec_from_file_location(name, cand)
            mod = importlib.util.module_from_spec(spec)
            # dataclasses resolves forward annotations through sys.modules.
            sys.modules[name] = mod
            spec.loader.exec_module(mod)
            return mod
    return None


cs = _load_lib("claude_sessions")
ledger_lib = _load_lib("convo_ledger")


# Ledger parsing policy is intentionally versioned.  It is part of a source cache key:
# a normalizer or retention-policy change must re-evaluate old physical files.
LEDGER_POLICY_VERSION = "normalized-user-assistant-v2"
LEDGER_JSONL_PARSER_VERSION = "stream-jsonl-v1"
LEDGER_GEMINI_PARSER_VERSION = "whole-document-v1"
MAX_JSONL_ROW_BYTES = 32 * 1024 * 1024
MAX_NORMALIZED_MESSAGE_BYTES = 8 * 1024 * 1024


class SyncWriteError(RuntimeError):
    """A durable ledger write failed after parsing; do not mislabel it as source corruption."""


# --------------------------------------------------------------------------------------
# Unified schema
# --------------------------------------------------------------------------------------

@dataclass
class Turn:
    role: str                      # "user" | "assistant"
    text: str                      # all text blocks joined (text/grep modes)
    ts: Optional[str] = None       # ISO timestamp if known
    # Separate text blocks in emission order. For an assistant turn that streamed several
    # text blocks across tool rounds, texts[-1] is the genuine LAST reply ("final" mode).
    texts: list = field(default_factory=list)
    # full-mode extras (only populated when needed):
    events: list = field(default_factory=list)  # [{kind, name, text}] for tool_use/result/thinking

    def add_text(self, t: str):
        if t:
            self.texts.append(t)
            self.text = ("\n\n".join(self.texts)).strip()


@dataclass
class Session:
    harness: str
    session_id: str
    path: str
    project: Optional[str]         # human-readable project/cwd if known
    mtime: float
    turns: list = field(default_factory=list)   # list[Turn], chronological

    @property
    def started(self) -> Optional[str]:
        for t in self.turns:
            if t.ts:
                return t.ts
        return None

    @property
    def first_user_text(self) -> str:
        for t in self.turns:
            if t.role == "user" and t.text.strip():
                return t.text.strip()
        return ""

    @property
    def last_user_text(self) -> str:
        for t in reversed(self.turns):
            if t.role == "user" and t.text.strip():
                return t.text.strip()
        return ""


# --------------------------------------------------------------------------------------
# Shared text cleaning
# --------------------------------------------------------------------------------------

SYS_REMINDER_RE = re.compile(r"<system-reminder>.*?</system-reminder>", re.DOTALL)
MULTINEWLINE_RE = re.compile(r"\n{3,}")


def clean_text(text: Any) -> str:
    """Strip system-reminder blocks and collapse excess blank lines."""
    if not isinstance(text, str):
        return ""
    text = SYS_REMINDER_RE.sub("", text)
    text = MULTINEWLINE_RE.sub("\n\n", text)
    return text.strip()


def _terminal_safe(text: str) -> str:
    """Remove terminal control bytes from untrusted transcript text."""
    return "".join(ch for ch in text if ch in "\n\t" or ord(ch) >= 0x20 and not 0x7F <= ord(ch) <= 0x9F)


# Markers that mean "this 'user' turn is not a real human prompt" (Claude + Codex).
_META_USER_MARKERS = (
    "<local-command-",
    "<command-name>",
    "<command-message>",
    "<command-args>",
    "# AGENTS.md instructions",
    "<INSTRUCTIONS>",
    "Caveat: The messages below were generated by the user while running",
    # Claude compaction summary, injected as a `user` turn — not a real human prompt.
    # Sourced from the shared lib when available so the marker has one definition.
    (cs.COMPACTION_MARKER if cs else "continued from a previous conversation"),
)


def _looks_like_meta_user(text: str) -> bool:
    """Heuristic: is this 'user' content actually a system/command/env injection?"""
    s = text.lstrip()
    if not s:
        return True
    for m in _META_USER_MARKERS:
        if m in text:
            return True
    # Shell-status injections like "   \n~ > updates --apply" (kitty status line refresh)
    if s.startswith("~ >"):
        return True
    return False


# --------------------------------------------------------------------------------------
# Loaders — one per harness, each returns a Session (or None)
# --------------------------------------------------------------------------------------

def _read_jsonl(path: Path) -> Iterable[dict]:
    """Parse JSONL; tolerate only a torn final line from an active writer."""
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        pending = None
        for line_no, line in enumerate(fh, 1):
            if pending is not None:
                prior_no, prior = pending
                prior = prior.strip()
                if prior:
                    try:
                        yield json.loads(prior)
                    except json.JSONDecodeError as exc:
                        raise ValueError(f"corrupt JSONL at {path}:{prior_no}: {exc.msg}") from exc
            pending = (line_no, line)
        if pending is not None:
            _, line = pending
            terminated = line.endswith("\n")
            line = line.strip()
            if not line:
                return
            try:
                yield json.loads(line)
            except json.JSONDecodeError as exc:
                if terminated:
                    raise ValueError(f"corrupt JSONL at {path}:{pending[0]}: {exc.msg}") from exc
                return


def load_claude(path: Path) -> Optional[Session]:
    """Claude Code: ~/.claude/projects/<slug>/<sessionId>.jsonl"""
    session_id = path.stem
    cwd = None
    turns: list[Turn] = []

    for row in _read_jsonl(path):
        rtype = row.get("type")
        if row.get("isSidechain"):
            continue
        if cwd is None and row.get("cwd"):
            cwd = row["cwd"]
        ts = row.get("timestamp")

        if rtype == "user":
            if row.get("isMeta"):
                continue
            msg = row.get("message", {})
            content = msg.get("content")
            if isinstance(content, str):
                txt = clean_text(content)
                if txt and (row.get("isMeta") is False or not _looks_like_meta_user(content)):
                    turns.append(Turn("user", txt, ts))
            elif isinstance(content, list):
                # List form: real user text blocks, OR tool_results masquerading as 'user'.
                text_parts, events = [], []
                for b in content:
                    if not isinstance(b, dict):
                        continue
                    bt = b.get("type")
                    if bt == "text":
                        t = clean_text(b.get("text", ""))
                        if t and (row.get("isMeta") is False or not _looks_like_meta_user(b.get("text", ""))):
                            text_parts.append(t)
                    elif bt in ("image", "image_url", "input_image") or "source" in b and bt != "tool_result":
                        text_parts.append("[image]")
                    elif bt == "tool_result":
                        events.append({
                            "kind": "tool_result",
                            "name": b.get("tool_use_id", ""),
                            "text": _stringify_tool_result(b.get("content", "")),
                        })
                if text_parts:
                    turns.append(Turn("user", "\n\n".join(text_parts), ts, events))
                elif events:
                    # Pure tool-result turn: attach to the preceding assistant turn's events.
                    if turns and turns[-1].role == "assistant":
                        turns[-1].events.extend(events)

        elif rtype == "assistant":
            msg = row.get("message", {})
            content = msg.get("content", [])
            text_parts, events = [], []
            if isinstance(content, list):
                for b in content:
                    if not isinstance(b, dict):
                        continue
                    bt = b.get("type")
                    if bt == "text":
                        t = clean_text(b.get("text", ""))
                        if t:
                            text_parts.append(t)
                    elif bt in ("image", "image_url", "output_image") or "source" in b and bt not in ("tool_use", "thinking"):
                        text_parts.append("[image]")
                    elif bt == "thinking":
                        events.append({"kind": "thinking", "name": "",
                                       "text": clean_text(b.get("thinking", ""))})
                    elif bt == "tool_use":
                        events.append({"kind": "tool_use", "name": b.get("name", ""),
                                       "text": _stringify_tool_input(b.get("input", {}))})
            elif isinstance(content, str):
                t = clean_text(content)
                if t:
                    text_parts.append(t)
            # Merge consecutive assistant rows into one logical turn (Claude streams many),
            # but keep each text block separate so "final" mode can pick the true last one.
            if turns and turns[-1].role == "assistant":
                prev = turns[-1]
                for tp in text_parts:
                    prev.add_text(tp)
                prev.events.extend(events)
            else:
                turn = Turn("assistant", "", ts, events=events)
                for tp in text_parts:
                    turn.add_text(tp)
                turns.append(turn)

    if not turns:
        return None
    return Session("claude", session_id, str(path), cwd, path.stat().st_mtime, turns)


def load_codex(path: Path) -> Optional[Session]:
    """Codex CLI: ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl"""
    session_id = path.stem.replace("rollout-", "")
    cwd = None
    turns: list[Turn] = []
    seen_first_user = False

    for row in _read_jsonl(path):
        if row.get("type") == "session_meta":
            p = row.get("payload", {})
            cwd = p.get("cwd") or p.get("cwd_path") or cwd
            continue
        if row.get("type") != "response_item":
            continue
        p = row.get("payload", {})
        ptype = p.get("type")
        ts = row.get("timestamp")

        if ptype == "message":
            role = p.get("role")
            text = _codex_text(p.get("content"))
            if role == "user":
                # First user message is the AGENTS.md/env preamble — skip it and any meta.
                if _looks_like_meta_user(text):
                    seen_first_user = True
                    continue
                if not text.strip():
                    continue
                turns.append(Turn("user", clean_text(text), ts))
                seen_first_user = True
            elif role == "assistant":
                t = clean_text(text)
                if turns and turns[-1].role == "assistant":
                    turns[-1].add_text(t)
                else:
                    turn = Turn("assistant", "", ts)
                    turn.add_text(t)
                    turns.append(turn)
            # role == "developer"/"system" → ignore
        elif ptype in ("function_call", "custom_tool_call"):
            ev = {"kind": "tool_use", "name": p.get("name", ""),
                  "text": _stringify_tool_input(p.get("arguments", p.get("input", "")))}
            if not turns or turns[-1].role != "assistant":
                turns.append(Turn("assistant", "", ts))
            turns[-1].events.append(ev)
        elif ptype in ("function_call_output", "custom_tool_call_output"):
            ev = {"kind": "tool_result", "name": p.get("call_id", ""),
                  "text": _stringify_tool_result(p.get("output", ""))}
            if not turns or turns[-1].role != "assistant":
                turns.append(Turn("assistant", "", ts))
            turns[-1].events.append(ev)
        elif ptype == "reasoning":
            ev = {"kind": "thinking", "name": "", "text": _codex_text(p.get("summary", p.get("content")))}
            if not turns or turns[-1].role != "assistant":
                turns.append(Turn("assistant", "", ts))
            turns[-1].events.append(ev)

    if not turns:
        return None
    return Session("codex", session_id, str(path), cwd, path.stat().st_mtime, turns)


def load_gemini(path: Path) -> Optional[Session]:
    """Gemini CLI: ~/.gemini/tmp/<projectHash>/chats/session-*.json"""
    try:
        obj = json.loads(path.read_text(encoding="utf-8", errors="replace"))
    except json.JSONDecodeError as exc:
        raise ValueError(f"corrupt Gemini session {path}: {exc.msg}") from exc
    if not isinstance(obj, dict):
        raise ValueError(f"unsupported Gemini session schema in {path}: top level must be an object")
    msgs = obj.get("messages")
    if not isinstance(msgs, list):
        raise ValueError(f"unsupported Gemini session schema in {path}: messages must be an array")

    session_id = obj.get("sessionId") or path.stem
    turns: list[Turn] = []
    for m in msgs:
        if not isinstance(m, dict):
            continue
        mtype = m.get("type")
        ts = m.get("timestamp")
        content = m.get("content")
        text = content if isinstance(content, str) else _codex_text(content)
        if mtype == "user":
            t = clean_text(text)
            if t and not _looks_like_meta_user(text):
                turns.append(Turn("user", t, ts))
        elif mtype in ("gemini", "assistant", "model"):
            t = clean_text(text)
            if turns and turns[-1].role == "assistant":
                turns[-1].add_text(t)
            else:
                turn = Turn("assistant", "", ts)
                turn.add_text(t)
                turns.append(turn)

    if not turns:
        return None
    # project hash dir is the parent-of-parent (chats/ -> <hash>/)
    project = obj.get("projectHash")
    return Session("gemini", session_id, str(path), project, path.stat().st_mtime, turns)


def load_qwen(path: Path) -> Optional[Session]:
    """Qwen Code: ~/.qwen/projects/<slug>/chats/<sessionId>.jsonl."""
    session_id = path.stem
    cwd = None
    turns: list[Turn] = []

    for row in _read_jsonl(path):
        if cwd is None and row.get("cwd"):
            cwd = row["cwd"]
        rtype = row.get("type")
        ts = row.get("timestamp")
        msg = row.get("message", {})
        parts = msg.get("parts", []) if isinstance(msg, dict) else []

        # Qwen records status notifications and task results as user-shaped messages.
        # Only provenance=real_user represents an actual prompt from the human.
        if rtype == "user" and row.get("provenance") == "real_user":
            text_parts = []
            for part in parts:
                if isinstance(part, dict) and isinstance(part.get("text"), str):
                    text = clean_text(part["text"])
                    if text:
                        text_parts.append(text)
            text = "\n\n".join(text_parts)
            if text and not _looks_like_meta_user(text):
                turns.append(Turn("user", text, ts))

        elif rtype == "assistant":
            text_parts, events = [], []
            for part in parts:
                if not isinstance(part, dict):
                    continue
                if isinstance(part.get("text"), str):
                    text = clean_text(part["text"])
                    if text and part.get("thought") is True:
                        events.append({"kind": "thinking", "name": "", "text": text})
                    elif text:
                        text_parts.append(text)
                elif isinstance(part.get("functionCall"), dict):
                    call = part["functionCall"]
                    events.append({
                        "kind": "tool_use",
                        "name": call.get("name", ""),
                        "text": _stringify_tool_input(call.get("args", {})),
                    })
            if turns and turns[-1].role == "assistant":
                previous = turns[-1]
                for text in text_parts:
                    previous.add_text(text)
                previous.events.extend(events)
            else:
                turn = Turn("assistant", "", ts, events=events)
                for text in text_parts:
                    turn.add_text(text)
                turns.append(turn)

        elif rtype == "tool_result":
            events = []
            for part in parts:
                if not isinstance(part, dict) or not isinstance(part.get("functionResponse"), dict):
                    continue
                response = part["functionResponse"]
                events.append({
                    "kind": "tool_result",
                    "name": response.get("name", response.get("id", "")),
                    "text": _stringify_tool_result(response.get("response", "")),
                })
            if events:
                if not turns or turns[-1].role != "assistant":
                    turns.append(Turn("assistant", "", ts))
                turns[-1].events.extend(events)

    if not turns:
        return None
    return Session("qwen", session_id, str(path), cwd, path.stat().st_mtime, turns)


# --------------------------------------------------------------------------------------
# Tool/content stringification helpers
# --------------------------------------------------------------------------------------

def _codex_text(content: Any) -> str:
    """Codex/Gemini content is often a list of {type, text} blocks."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for b in content:
            if isinstance(b, dict):
                text = b.get("text", "") or b.get("content", "") or ""
                if text:
                    parts.append(text)
                elif b.get("type") in ("image", "image_url", "input_image", "output_image") or "image_url" in b:
                    parts.append("[image]")
            elif isinstance(b, str):
                parts.append(b)
        return "\n".join(p for p in parts if p)
    return ""


def _stringify_tool_input(inp: Any, limit: int = 1500) -> str:
    try:
        s = inp if isinstance(inp, str) else json.dumps(inp, indent=2, ensure_ascii=False)
    except (TypeError, ValueError):
        s = str(inp)
    return s if len(s) <= limit else s[:limit] + f"\n... (+{len(s) - limit} chars)"


def _stringify_tool_result(content: Any, limit: int = 2000) -> str:
    if isinstance(content, list):
        parts = []
        for it in content:
            if isinstance(it, dict) and it.get("type") == "text":
                parts.append(it.get("text", ""))
            elif isinstance(it, dict):
                parts.append(json.dumps(it, ensure_ascii=False))
            else:
                parts.append(str(it))
        s = "\n".join(parts)
    elif isinstance(content, str):
        s = content
    else:
        s = json.dumps(content, ensure_ascii=False) if content else ""
    s = clean_text(s) if isinstance(s, str) else str(s)
    return s if len(s) <= limit else s[:limit] + f"\n... (+{len(s) - limit} chars)"


# --------------------------------------------------------------------------------------
# Lightweight peek — summary fields without parsing a whole (possibly 500MB) file.
# --------------------------------------------------------------------------------------

@dataclass
class Peek:
    harness: str
    session_id: str
    path: str
    project: Optional[str]
    mtime: float
    first_user: str
    user_msgs: int       # exact for small files, lower-bound (capped) for huge ones
    truncated: bool      # True if we stopped scanning before EOF


_PEEK_MAX_LINES = 4000   # scan cap for huge JSONL rollouts


def peek_claude(path: Path) -> Optional[Peek]:
    cwd = None
    first_user = ""
    user_msgs = 0
    truncated = False
    for i, row in enumerate(_read_jsonl(path)):
        if i >= _PEEK_MAX_LINES:
            truncated = True
            break
        if cwd is None and row.get("cwd"):
            cwd = row["cwd"]
        if row.get("type") == "user" and not row.get("isMeta") and not row.get("isSidechain"):
            c = row.get("message", {}).get("content")
            texts = [c] if isinstance(c, str) else [b.get("text", "") if b.get("type") == "text" else "[image]" for b in c if isinstance(b, dict) and b.get("type") in ("text", "image", "image_url", "input_image")] if isinstance(c, list) else []
            real = [t for t in texts if t.strip() and (row.get("isMeta") is False or not _looks_like_meta_user(t))]
            if real:
                user_msgs += 1
                if not first_user:
                    first_user = clean_text("\n\n".join(real))
    if user_msgs == 0 and not first_user:
        return None
    return Peek("claude", path.stem, str(path), cwd, path.stat().st_mtime,
                first_user, user_msgs, truncated)


def peek_codex(path: Path) -> Optional[Peek]:
    cwd = None
    first_user = ""
    user_msgs = 0
    truncated = False
    for i, row in enumerate(_read_jsonl(path)):
        if i >= _PEEK_MAX_LINES:
            truncated = True
            break
        if row.get("type") == "session_meta":
            p = row.get("payload", {})
            cwd = p.get("cwd") or p.get("cwd_path") or cwd
            continue
        if row.get("type") != "response_item":
            continue
        p = row.get("payload", {})
        if p.get("type") == "message" and p.get("role") == "user":
            txt = _codex_text(p.get("content"))
            if txt.strip() and not _looks_like_meta_user(txt):
                user_msgs += 1
                if not first_user:
                    first_user = clean_text(txt)
    if user_msgs == 0 and not first_user:
        return None
    return Peek("codex", path.stem.replace("rollout-", ""), str(path), cwd,
                path.stat().st_mtime, first_user, user_msgs, truncated)


def peek_gemini(path: Path) -> Optional[Peek]:
    # Gemini chat files are small single-JSON; just load fully.
    s = load_gemini(path)
    if not s:
        return None
    return Peek("gemini", s.session_id, s.path, s.project, s.mtime,
                s.first_user_text, sum(1 for t in s.turns if t.role == "user"), False)


def peek_qwen(path: Path) -> Optional[Peek]:
    cwd = None
    first_user = ""
    user_msgs = 0
    truncated = False
    for i, row in enumerate(_read_jsonl(path)):
        if i >= _PEEK_MAX_LINES:
            truncated = True
            break
        if cwd is None and row.get("cwd"):
            cwd = row["cwd"]
        if row.get("type") != "user" or row.get("provenance") != "real_user":
            continue
        msg = row.get("message", {})
        parts = msg.get("parts", []) if isinstance(msg, dict) else []
        texts = [part["text"] for part in parts
                 if isinstance(part, dict) and isinstance(part.get("text"), str)]
        text = clean_text("\n\n".join(texts))
        if text and not _looks_like_meta_user(text):
            user_msgs += 1
            if not first_user:
                first_user = text
    if user_msgs == 0 and not first_user:
        return None
    return Peek("qwen", path.stem, str(path), cwd, path.stat().st_mtime,
                first_user, user_msgs, truncated)


