def parse_since(s: Optional[str]) -> Optional[float]:
    """Parse a --since value to an epoch-seconds floor.

    Returns None when not provided. Raises ValueError on an UNparseable value so the
    caller can fail loudly — silently treating 'garbage' as 'no window' would return
    an empty list that looks like 'you have no sessions', which is a footgun.
    """
    if not s:
        return None
    now = datetime.now(timezone.utc).timestamp()
    m = re.fullmatch(r"(\d+)\s*([dhmw])", s.strip())
    if m:
        val, unit = int(m.group(1)), m.group(2)
        mult = {"m": 60, "h": 3600, "d": 86400, "w": 604800}[unit]
        return now - val * mult
    try:
        return datetime.fromisoformat(s).timestamp()
    except ValueError:
        raise ValueError(
            f"invalid --since value {s!r} (use 7d, 24h, 30m, 2w, or an ISO date like 2026-06-01)"
        )


def resolve_harnesses(arg: Optional[str]) -> list[str]:
    if not arg or arg == "all":
        return list(HARNESSES.keys())
    out = []
    for h in arg.split(","):
        h = h.strip().lower()
        alias = {
            "cc": "claude", "cx": "codex", "gm": "gemini", "gemini-cli": "gemini",
            "qw": "qwen", "qwen-code": "qwen",
        }.get(h, h)
        if alias in HARNESSES:
            out.append(alias)
        else:
            sys.exit(f"convo: unknown harness '{h}' (valid: {', '.join(HARNESSES)})")
    return out


def load_sessions(candidates: list[tuple[str, Path]], project_filter: Optional[str], errors: Optional[list[str]] = None) -> list[Session]:
    sessions: list[Session] = []
    for h, p in candidates:
        if not _candidate_may_match_project(h, p, project_filter):
            continue
        try:
            s = HARNESSES[h]["loader"](p)
        except Exception as exc:  # noqa: BLE001 — report partial results honestly
            if errors is not None:
                errors.append(f"{p}: {exc}")
            continue
        if not s:
            continue
        if project_filter and not _project_matches(s, p, h, project_filter):
            continue
        sessions.append(s)
    return sessions


def _project_matches(s: Session, p: Path, harness: str, flt: str) -> bool:
    """Match a project filter against the session's real cwd OR its path slug.

    Filter may be a full path (the cwd default) or a bare name like 'dotfiles'. The slug
    encodes the cwd with dashes (-home-tnunamak-code-dotfiles), so we compare against both
    the real cwd and a de-dashed slug to catch either filter style.
    """
    if "/" in flt:
        return bool(s.project) and str(Path(s.project).expanduser().resolve()) == str(Path(flt).expanduser().resolve())
    flt = flt.lower()
    cwd = (s.project or "").lower()
    slug = _slug_for_project(p, harness).lower()
    slug_path = slug.replace("-", "/")  # -home-x-code-foo -> /home/x/code/foo
    candidates = (cwd, slug, slug_path, Path(cwd).name if cwd else "")
    if any(flt in c for c in candidates if c):
        return True
    # also let a path-filter match the de-dashed slug (and vice-versa) by basename
    return Path(flt).name in {Path(c).name for c in candidates if c}


def default_project_slug() -> Optional[str]:
    """If run from inside a project, bias to it (matches Claude's dir-slug convention)."""
    cwd = str(Path.cwd())
    return cwd  # used as a substring filter; matches cwd inside codex/claude paths


def _ledger_sources() -> list[tuple[str, Path]]:
    """Find every physical source for a full ledger sync, without query-time caps."""
    sources: list[tuple[str, Path]] = []
    for harness, cfg in HARNESSES.items():
        root: Path = cfg["root"]
        if not root.exists():
            continue
        for path in root.glob(cfg["glob"]):
            if not cfg["skip"](path):
                sources.append((harness, path))
    return sorted(sources, key=lambda item: (item[0], str(item[1])))


def _require_ledger():
    if ledger_lib is None:
        sys.exit("convo: ledger support is unavailable (the vendored lib/convo_ledger.py is missing)")
    return ledger_lib.Ledger()


def _normalized_source(harness: str, path: Path, session: Session, stat_result) -> object:
    """Adapt the existing clean-turn parser to the ledger's narrow persistence contract."""
    messages = tuple(
        ledger_lib.Message(turn.role, turn.text, turn.ts)
        for turn in session.turns
        if turn.role in ("user", "assistant") and turn.text.strip()
    )
    return ledger_lib.ParsedSource(
        harness, str(path), stat_result.st_size, stat_result.st_mtime_ns, stat_result.st_dev,
        stat_result.st_ino, stat_result.st_ctime_ns, session.session_id, session.project, messages)


def _source_identity(stat_result) -> tuple[int, int, int, int, int]:
    return (stat_result.st_size, stat_result.st_mtime_ns, stat_result.st_dev,
            stat_result.st_ino, stat_result.st_ctime_ns)


@dataclass
class _StreamParse:
    """One bounded-memory ledger normalization result.

    JSONL parser errors are source-local.  Valid rows before and after a malformed
    complete row are retained in a temporary spool, then committed atomically.
    """
    source: object
    spool_path: Path
    message_bytes: int
    partial_error: Optional[str] = None
    pending_error: Optional[str] = None


def _spooled_messages(path: Path) -> Iterable[object]:
    with path.open("r", encoding="utf-8") as stream:
        for line in stream:
            item = json.loads(line)
            yield ledger_lib.Message(item["role"], item["text"], item.get("timestamp"))


def _sync_jsonl_rows(path: Path) -> Iterable[tuple[Optional[dict], Optional[str], bool]]:
    """Yield (row, diagnostic, pending) without ever loading a whole source.

    A malformed newline-terminated row is a durable partial diagnostic but does not
    stop later rows.  A final unterminated row is normal for a live append-only log:
    it is left pending until the writer completes it.  Individual JSON values still
    need a bounded buffer for stdlib ``json``; an overlarge row is skipped safely.
    """
    with path.open("rb") as stream:
        line_no = 0
        while True:
            raw = stream.readline(MAX_JSONL_ROW_BYTES + 1)
            if not raw:
                return
            line_no += 1
            if len(raw) > MAX_JSONL_ROW_BYTES and not raw.endswith(b"\n"):
                while raw and not raw.endswith(b"\n"):
                    raw = stream.readline(MAX_JSONL_ROW_BYTES + 1)
                yield None, f"JSONL row {line_no} exceeds {MAX_JSONL_ROW_BYTES} bytes", False
                continue
            complete = raw.endswith(b"\n")
            raw = raw.strip()
            if not raw:
                continue
            if not complete:
                yield None, f"unterminated final JSONL row at {path}:{line_no}", True
                return
            try:
                row = json.loads(raw.decode("utf-8", errors="replace"))
            except json.JSONDecodeError as exc:
                yield None, f"corrupt JSONL at {path}:{line_no}: {exc.msg}", False
                continue
            if not isinstance(row, dict):
                yield None, f"unsupported JSONL row at {path}:{line_no}: expected object", False
                continue
            yield row, None, False


def _normalized_jsonl_row(harness: str, row: dict, cwd: Optional[str]) -> tuple[Optional[str], list[tuple[str, str, Optional[str]]]]:
    """Return this physical row's retained messages, matching raw-reader policy."""
    cwd = cwd or row.get("cwd")
    ts = row.get("timestamp")
    out: list[tuple[str, str, Optional[str]]] = []
    if harness == "claude":
        if row.get("isSidechain"):
            return cwd, out
        rtype = row.get("type")
        content = row.get("message", {}).get("content") if isinstance(row.get("message"), dict) else None
        if rtype == "user" and not row.get("isMeta"):
            if isinstance(content, str):
                text = clean_text(content)
                if text and (row.get("isMeta") is False or not _looks_like_meta_user(content)):
                    out.append(("user", text, ts))
            elif isinstance(content, list):
                parts = []
                for block in content:
                    if not isinstance(block, dict):
                        continue
                    if block.get("type") == "text":
                        text = clean_text(block.get("text", ""))
                        if text and (row.get("isMeta") is False or not _looks_like_meta_user(block.get("text", ""))):
                            parts.append(text)
                    elif block.get("type") in ("image", "image_url", "input_image") or (
                            "source" in block and block.get("type") != "tool_result"):
                        parts.append("[image]")
                if parts:
                    out.append(("user", "\n\n".join(parts), ts))
        elif rtype == "assistant":
            parts = []
            blocks = content if isinstance(content, list) else [{"type": "text", "text": content}]
            for block in blocks:
                if not isinstance(block, dict):
                    continue
                if block.get("type") == "text":
                    text = clean_text(block.get("text", ""))
                    if text:
                        parts.append(text)
                elif block.get("type") in ("image", "image_url", "output_image") or (
                        "source" in block and block.get("type") not in ("tool_use", "thinking")):
                    parts.append("[image]")
            if parts:
                out.append(("assistant", "\n\n".join(parts), ts))
    elif harness == "codex":
        if row.get("type") == "session_meta":
            payload = row.get("payload", {})
            if isinstance(payload, dict):
                cwd = cwd or payload.get("cwd") or payload.get("cwd_path")
        elif row.get("type") == "response_item":
            payload = row.get("payload", {})
            if isinstance(payload, dict) and payload.get("type") == "message":
                role = payload.get("role")
                text = clean_text(_codex_text(payload.get("content")))
                if role == "user" and text and not _looks_like_meta_user(text):
                    out.append(("user", text, ts))
                elif role == "assistant" and text:
                    out.append(("assistant", text, ts))
    elif harness == "qwen":
        msg = row.get("message", {})
        parts = msg.get("parts", []) if isinstance(msg, dict) else []
        if row.get("type") == "user" and row.get("provenance") == "real_user":
            texts = [clean_text(part.get("text", "")) for part in parts
                     if isinstance(part, dict) and isinstance(part.get("text"), str)]
            text = "\n\n".join(text for text in texts if text)
            if text and not _looks_like_meta_user(text):
                out.append(("user", text, ts))
        elif row.get("type") == "assistant":
            texts = []
            for part in parts:
                if isinstance(part, dict) and isinstance(part.get("text"), str) and not part.get("thought"):
                    text = clean_text(part["text"])
                    if text:
                        texts.append(text)
            if texts:
                out.append(("assistant", "\n\n".join(texts), ts))
    return cwd, out


def _stream_jsonl_source(harness: str, path: Path, stat_result, temp_dir: Path) -> _StreamParse:
    """Normalize a Claude/Codex/Qwen source through a disk spool, not a Session list."""
    session_id = path.stem.replace("rollout-", "") if harness == "codex" else path.stem
    cwd: Optional[str] = None
    malformed_error_count = 0
    other_partial_count = 0
    partial_error_samples: list[str] = []
    pending_error: Optional[str] = None
    message_bytes = 0
    temp_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    spool_path: Optional[Path] = None
    pending_assistant: Optional[io.StringIO] = None
    pending_assistant_timestamp: Optional[str] = None
    pending_assistant_bytes = 0

    def write_message(spool, role: str, text: str, timestamp: Optional[str]) -> None:
        nonlocal message_bytes
        spool.write(json.dumps({"role": role, "text": text, "timestamp": timestamp}, ensure_ascii=False))
        spool.write("\n")
        message_bytes += len(text.encode("utf-8"))

    def remember_partial(diagnostic: str, *, malformed: bool = False) -> None:
        nonlocal malformed_error_count, other_partial_count
        if malformed:
            malformed_error_count += 1
        else:
            other_partial_count += 1
        if len(partial_error_samples) < 3:
            partial_error_samples.append(diagnostic)

    def flush_assistant(spool) -> None:
        nonlocal pending_assistant, pending_assistant_timestamp, pending_assistant_bytes
        if pending_assistant is not None:
            write_message(spool, "assistant", pending_assistant.getvalue(), pending_assistant_timestamp)
        pending_assistant = None
        pending_assistant_timestamp = None
        pending_assistant_bytes = 0

    def append_assistant(spool, text: str, timestamp: Optional[str]) -> None:
        """Merge ordinary rows exactly; split only a cap-exceeding normalized message."""
        nonlocal pending_assistant, pending_assistant_timestamp, pending_assistant_bytes
        text_bytes = len(text.encode("utf-8"))
        separator = "\n\n" if pending_assistant_bytes else ""
        if pending_assistant_bytes + len(separator) + text_bytes <= MAX_NORMALIZED_MESSAGE_BYTES:
            if pending_assistant is None:
                pending_assistant = io.StringIO()
                pending_assistant_timestamp = timestamp
            if separator:
                pending_assistant.write(separator)
                pending_assistant_bytes += len(separator)
            pending_assistant.write(text)
            pending_assistant_bytes += text_bytes
            return
        split = False
        pieces = (separator, text)
        for piece in pieces:
            for char in piece:
                char_bytes = len(char.encode("utf-8"))
                if pending_assistant is None:
                    pending_assistant = io.StringIO()
                    pending_assistant_timestamp = timestamp
                if pending_assistant_bytes and pending_assistant_bytes + char_bytes > MAX_NORMALIZED_MESSAGE_BYTES:
                    flush_assistant(spool)
                    split = True
                    pending_assistant = io.StringIO()
                    pending_assistant_timestamp = timestamp
                pending_assistant.write(char)
                pending_assistant_bytes += char_bytes
        if split:
            remember_partial(
                f"normalized assistant message exceeds {MAX_NORMALIZED_MESSAGE_BYTES} bytes; retained in chunks"
            )

    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=temp_dir, prefix="sync-", suffix=".jsonl", delete=False) as spool:
            spool_path = Path(spool.name)
            for row, diagnostic, pending in _sync_jsonl_rows(path):
                if diagnostic:
                    if pending:
                        pending_error = diagnostic
                        break
                    flush_assistant(spool)
                    remember_partial(diagnostic, malformed=True)
                    continue
                cwd, messages = _normalized_jsonl_row(harness, row, cwd)
                for role, text, timestamp in messages:
                    if role == "assistant":
                        append_assistant(spool, text, timestamp)
                        continue
                    if pending_assistant is not None:
                        flush_assistant(spool)
                    write_message(spool, role, text, timestamp)
            if pending_assistant is not None:
                flush_assistant(spool)
    except BaseException:
        if spool_path is not None:
            spool_path.unlink(missing_ok=True)
        raise
    partial_error_count = malformed_error_count + other_partial_count
    status = "partial" if partial_error_count else ("pending" if pending_error else "present")
    if partial_error_count:
        reasons = []
        if malformed_error_count:
            reasons.append(f"{malformed_error_count} malformed JSONL row(s)")
        if other_partial_count:
            reasons.append(f"{other_partial_count} other partial diagnostic(s)")
        error = ", ".join(reasons) + ": " + "; ".join(partial_error_samples)
    else:
        error = pending_error
    if not message_bytes and status == "present":
        status = "skipped"
        error = "source contains no normalized user or assistant messages"
    source = ledger_lib.ParsedSource(
        harness, str(path), stat_result.st_size, stat_result.st_mtime_ns, stat_result.st_dev,
        stat_result.st_ino, stat_result.st_ctime_ns, session_id, cwd,
        _spooled_messages(spool_path), status, error,
    )
    return _StreamParse(source, spool_path, message_bytes, error if status == "partial" else None,
                        error if status == "pending" else None)


def _cmd_sync_with_ledger(ledger, args):
    """Incrementally capture every current source; retained rows survive disappearance."""
    max_source_bytes = ledger_lib.max_source_bytes_from_environment()
    started = datetime.now(timezone.utc).timestamp()
    imported = unchanged = failed = skipped = partial = pending_sources = 0
    observed_bytes = 0
    processed_bytes = 0
    seen: list[str] = []
    staged: list[tuple[Callable[[], None], Callable[[], None]]] = []
    pending_message_bytes = 0
    total_sources = _ledger_sources()
    total = len(total_sources)

    def report_progress(index: int) -> None:
        if not total or (index != total and index % 100 != 0):
            return
        elapsed = max(datetime.now(timezone.utc).timestamp() - started, 0.001)
        if not sys.stderr.isatty():
            return
        rate = processed_bytes / elapsed / (1024 * 1024)
        print(f"convo: sync progress sources={index}/{total} observed-bytes={observed_bytes} processed-bytes={processed_bytes} elapsed={elapsed:.1f}s throughput={rate:.1f}MiB/s", file=sys.stderr)

    def flush() -> None:
        """Apply buffered rows quickly; parsing and hashing always happen outside a write txn."""
        nonlocal pending_message_bytes
        if not staged:
            return
        try:
            ledger.begin_batch()
            for operation, _cleanup in staged:
                operation()
            ledger.commit_batch()
        except Exception as exc:
            ledger.rollback_batch()  # prior flushes are durable; the context manager owns close()
            for _operation, cleanup in staged:
                cleanup()
            staged.clear()
            pending_message_bytes = 0
            raise SyncWriteError("ledger write transaction failed") from exc
        staged.clear()
        pending_message_bytes = 0

    def stage(operation: Callable[[], None], message_bytes: int = 0,
              cleanup: Optional[Callable[[], None]] = None) -> None:
        nonlocal pending_message_bytes
        staged.append((operation, cleanup or (lambda: None)))
        pending_message_bytes += message_bytes
        if (len(staged) >= ledger_lib.SYNC_BATCH_SIZE
                or pending_message_bytes >= ledger_lib.SYNC_BATCH_MESSAGE_BYTES):
            flush()

    for index, (harness, path) in enumerate(total_sources, 1):
        # A globbed path is evidence of presence for this run even if a concurrent
        # permission/race error keeps us from reading it now.
        seen.append(str(path))
        try:
            stat_result = path.stat()
        except OSError as exc:
            stage(lambda harness=harness, path=path, exc=exc:
                  ledger.record_access_failure(harness, path, exc))
            failed += 1
            if args.verbose:
                print(f"convo: source preserved after access failure: {path}: {exc}", file=sys.stderr)
            report_progress(index)
            continue
        observed_bytes += stat_result.st_size
        parser_version = LEDGER_GEMINI_PARSER_VERSION if harness == "gemini" else LEDGER_JSONL_PARSER_VERSION
        source_cap = max_source_bytes if harness == "gemini" else None
        current_outcome = ledger.current_source_outcome(
            harness, path, stat_result, parser_version, LEDGER_POLICY_VERSION, source_cap)
        if current_outcome is not None:
            current_status = current_outcome["source_status"]
            unchanged += 1
            if current_status == "skipped":
                skipped += 1
            elif current_status == "pending":
                pending_sources += 1
            elif current_status == "partial":
                partial += 1
            elif current_status in ("corrupt", "oversized"):
                failed += 1
            if args.verbose and current_status in ("partial", "pending", "corrupt", "oversized"):
                print(f"convo: cached source {current_status}: {path}: "
                      f"{current_outcome['parser_error'] or '(no diagnostic)'}", file=sys.stderr)
            report_progress(index)
            continue
        # Gemini is a whole-document format.  JSONL harnesses stream through a disk
        # spool and therefore have no whole-source size cap.
        if harness == "gemini" and stat_result.st_size > max_source_bytes:
            stage(lambda harness=harness, path=path, stat_result=stat_result,
                         parser_version=parser_version, source_cap=source_cap:
                  ledger.record_oversized(harness, path, stat_result, max_source_bytes,
                                          parser_version, LEDGER_POLICY_VERSION))
            failed += 1
            if args.verbose:
                print(f"convo: source preserved but not parsed (oversized): {path}: "
                      f"{stat_result.st_size} bytes exceeds cap {max_source_bytes}", file=sys.stderr)
            report_progress(index)
            continue
        spool_path = None
        spool_staged = False
        try:
            processed_bytes += stat_result.st_size
            if harness in ("claude", "codex", "qwen"):
                parsed = _stream_jsonl_source(harness, path, stat_result, ledger.data_dir / "spool")
                source = parsed.source
                spool_path = parsed.spool_path
                retained_bytes = parsed.message_bytes
            else:
                session = HARNESSES[harness]["loader"](path)
                if session is None:
                    source = ledger_lib.ParsedSource(
                        harness, str(path), stat_result.st_size, stat_result.st_mtime_ns,
                        stat_result.st_dev, stat_result.st_ino, stat_result.st_ctime_ns,
                        path.stem, None, (), "skipped",
                        "source contains no normalized user or assistant messages",
                    )
                else:
                    source = _normalized_source(harness, path, session, stat_result)
                    if not source.messages:
                        source = ledger_lib.ParsedSource(
                            source.harness, source.path, source.size, source.mtime_ns, source.device,
                            source.inode, source.ctime_ns, source.session_id, source.project, (), "skipped",
                            "source contains no normalized user or assistant messages",
                        )
                retained_bytes = sum(len(message.text.encode("utf-8")) for message in source.messages)
            content_hash = ledger.hash_file(path)
            # Capture the bytes whose identity we persist. A source that changed during
            # parsing is retried on the next idempotent sync rather than being mislabeled.
            final_stat = path.stat()
            if _source_identity(final_stat) != _source_identity(stat_result):
                raise ValueError("source changed while parsing or hashing; retry sync")
            if source.source_status == "partial" and not retained_bytes:
                detail = source.parser_error or "source has no safely normalized messages"
                stage(lambda harness=harness, path=path, stat_result=stat_result, detail=detail,
                             parser_version=parser_version, source_cap=source_cap:
                      ledger.record_partial(harness, path, stat_result, detail, parser_version,
                                            LEDGER_POLICY_VERSION, source_cap))
                if spool_path is not None:
                    spool_path.unlink(missing_ok=True)
                    spool_path = None
                imported += 1
                partial += 1
                if args.verbose:
                    print(f"convo: source retained as partial: {path}: {detail}", file=sys.stderr)
                report_progress(index)
                continue
            def replace(source=source, content_hash=content_hash, spool_path=spool_path,
                        parser_version=parser_version, source_cap=source_cap):
                try:
                    ledger.replace_source(source, content_hash, parser_version, LEDGER_POLICY_VERSION, source_cap)
                finally:
                    if spool_path is not None:
                        spool_path.unlink(missing_ok=True)
            stage(replace, retained_bytes,
                  cleanup=(lambda spool_path=spool_path: spool_path.unlink(missing_ok=True)
                           if spool_path is not None else None))
            spool_staged = True
            imported += 1
            if source.source_status == "skipped":
                skipped += 1
            elif source.source_status == "partial":
                partial += 1
                if args.verbose:
                    print(f"convo: source retained as partial: {path}: {source.parser_error}", file=sys.stderr)
            elif source.source_status == "pending":
                pending_sources += 1
                if args.verbose:
                    print(f"convo: source retained as pending: {path}: {source.parser_error}", file=sys.stderr)
        except SyncWriteError:
            raise
        except Exception as exc:  # Preserve the last successful snapshot on every failure.
            stage(lambda harness=harness, path=path, stat_result=stat_result, exc=exc,
                         parser_version=parser_version, source_cap=source_cap:
                  ledger.record_parse_failure(harness, path, stat_result, exc, parser_version,
                                              LEDGER_POLICY_VERSION, source_cap))
            failed += 1
            if args.verbose:
                print(f"convo: source preserved after parse failure: {path}: {exc}", file=sys.stderr)
        finally:
            if spool_path is not None and not spool_staged:
                spool_path.unlink(missing_ok=True)
        report_progress(index)
    flush()
    # The disappearance transition has no parse work behind it, so apply it alone.
    try:
        ledger.begin_batch()
        missing = ledger.mark_missing_except(seen)
        ledger.commit_batch()
    except Exception as exc:
        ledger.rollback_batch()
        raise SyncWriteError("ledger source-state transaction failed") from exc
    elapsed = max(datetime.now(timezone.utc).timestamp() - started, 0.001)
    result = {"schema_version": ledger_lib.SCHEMA_VERSION, "imported": imported,
              "unchanged": unchanged, "failed": failed, "skipped": skipped, "partial": partial,
              "pending": pending_sources, "marked_missing": missing, "sources_scanned": total,
              "bytes_observed": observed_bytes, "bytes_processed": processed_bytes,
              "elapsed_seconds": round(elapsed, 3),
              "throughput_mib_per_second": round(processed_bytes / elapsed / (1024 * 1024), 3)}
    if args.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print("convo: sync imported={imported} unchanged={unchanged} skipped={skipped} partial={partial} pending={pending} failed={failed} marked-missing={marked_missing} elapsed={elapsed_seconds:.1f}s throughput={throughput_mib_per_second:.1f}MiB/s".format(**result))
    if failed:
        raise SystemExit(2)


def cmd_sync(args):
    try:
        with _require_ledger() as ledger:
            with ledger.sync_lock():
                spool_dir = ledger.data_dir / "spool"
                if spool_dir.exists():
                    for stale_spool in spool_dir.glob("sync-*.jsonl"):
                        stale_spool.unlink(missing_ok=True)
                _cmd_sync_with_ledger(ledger, args)
    except SyncWriteError as exc:
        print(f"convo: sync stopped: {exc}", file=sys.stderr)
        raise SystemExit(2) from exc


def cmd_status(args):
    with _require_ledger() as ledger:
        status = ledger.status()
        if args.json:
            print(json.dumps(status, sort_keys=True))
            return
        source_counts = ", ".join(f"{key}={value}" for key, value in sorted(status["sources"].items())) or "none"
        print(f"convo ledger: {status['messages']} messages; sources: {source_counts}; "
              f"parser-failures={status['parser_failures']}; partial={status['partial_sources']}; "
              f"pending={status['pending_sources']}; skipped={status['skipped_sources']}; "
              f"oversized={status['oversized_sources']}")
        print(f"data: {status['data_dir']}")


def cmd_search(args):
    if args.limit < 1:
        sys.exit("convo: --limit must be at least 1")
    with _require_ledger() as ledger:
        results = ledger.search(args.query, args.limit, args.context)
        if args.json:
            print(json.dumps({"schema_version": ledger_lib.SCHEMA_VERSION, "results": results}, indent=2))
            return
        if not results:
            print("convo: no matches.", file=sys.stderr)
            return
        for result in results:
            label = (f"{result['harness']}:{result['session_id']} [{result['role']}] "
                     f"{_short_ts(result['timestamp'])} source={result['source_status']} "
                     f"completeness={result['completeness']} basis={result['content_basis']}")
            print(_terminal_safe(label))
            for item in result["context"]:
                marker = ">" if item["role"] == result["role"] and item["text"] == result["text"] else " "
                print(f"  {marker} {item['role']}: {_terminal_safe(' '.join(item['text'].split())[:500])}")
            command = f"convo show {shlex.quote(str(result['session_id']))}"
            print(_terminal_safe(f"  next: {command}"))
            print()


def cmd_list(args):
    if args.limit < 1:
        sys.exit("convo: --limit must be at least 1")
    since = parse_since(args.since)
    harnesses = resolve_harnesses(args.harness)
    proj = None if args.all_projects else (args.project or None)
    candidates = discover(harnesses, proj, since, args.limit)

    # Cheap peek (header-only) instead of full parse — huge rollouts stay fast.
    peeks: list[Peek] = []
    errors: list[str] = []
    for h, p in candidates:
        if not _candidate_may_match_project(h, p, proj):
            continue
        try:
            pk = HARNESSES[h]["peek"](p)
        except Exception as exc:  # noqa: BLE001
            errors.append(f"{p}: {exc}")
            continue
        if not pk:
            continue
        if proj and not peek_matches_project(pk, proj):
            continue
        peeks.append(pk)
    peeks.sort(key=lambda pk: pk.mtime, reverse=True)
    peeks = peeks[: args.limit]

    if args.json:
        print(json.dumps([{
            "harness": pk.harness, "session_id": pk.session_id, "path": pk.path,
            "project": pk.project, "mtime": pk.mtime, "user_msgs": pk.user_msgs,
            "user_msgs_truncated": pk.truncated, "first_user": pk.first_user[:200],
        } for pk in peeks], indent=2))
        for error in errors:
            print(f"convo: corrupt/unreadable session skipped: {error}", file=sys.stderr)
        if errors:
            sys.exit(2)
        return
    if not peeks:
        print("convo: no sessions matched.", file=sys.stderr)
        for error in errors:
            print(f"convo: corrupt/unreadable session skipped: {error}", file=sys.stderr)
        if errors:
            sys.exit(2)
        return
    for i, pk in enumerate(peeks, 1):
        print(summary_line(pk, i))
        print()
    for error in errors:
        print(f"convo: corrupt/unreadable session skipped: {error}", file=sys.stderr)
    if errors:
        sys.exit(2)


def _pick_session(args, require: bool = True) -> Optional[Session]:
    """Resolve a single session from --session id/path, or the most recent match."""
    target = args.session
    if target:
        p = Path(target).expanduser()
        if p.exists() and p.is_file():
            for h, cfg in HARNESSES.items():
                # crude harness detection by location
                if str(cfg["root"]) in str(p.resolve()):
                    return cfg["loader"](p)
            # fall back: try each loader
            for cfg in HARNESSES.values():
                s = cfg["loader"](p)
                if s:
                    return s
            sys.exit(f"convo: could not parse session file {p}")
        # treat as session-id substring
        harnesses = resolve_harnesses(args.harness)
        candidates = discover(harnesses, None, None, 9999)
        for h, pth in candidates:
            if target in pth.name:
                return HARNESSES[h]["loader"](pth)
        sys.exit(f"convo: no session matching id '{target}'")
    # no explicit session → most recent matching project/harness.
    # Peek (cheap) to find the right file, then load only that one.
    since = parse_since(args.since)
    harnesses = resolve_harnesses(args.harness)
    proj = None if args.all_projects else (args.project or None)
    candidates = discover(harnesses, proj, since, 50)
    best: Optional[tuple[float, str, Path]] = None
    errors: list[str] = []
    for h, p in candidates:
        if not _candidate_may_match_project(h, p, proj):
            continue
        try:
            pk = HARNESSES[h]["peek"](p)
        except Exception as exc:  # noqa: BLE001
            errors.append(f"{p}: {exc}")
            continue
        if not pk:
            continue
        if proj and not peek_matches_project(pk, proj):
            continue
        if best is None or pk.mtime > best[0]:
            best = (pk.mtime, h, p)
    if errors:
        for error in errors:
            print(f"convo: corrupt/unreadable session skipped: {error}", file=sys.stderr)
        sys.exit(2)
    if best is None:
        if require:
            sys.exit("convo: no sessions found (try --all-projects or --harness all)")
        return None
    return HARNESSES[best[1]]["loader"](best[2])


def cmd_show(args):
    s = _pick_session(args)
    if args.json:
        pairs = _tail(build_pairs(s), args.n)
        data = {
            "harness": s.harness, "session_id": s.session_id, "path": s.path,
            "project": s.project,
            "exchanges": [{
                "ts": ex["ts"], "user": ex["user"],
                "assistant_final": ex["assistant_texts"][-1] if ex["assistant_texts"] else "",
                "assistant_all": ex["assistant_texts"],
                **({"assistant_events": ex["assistant_events"]} if args.mode == "full" else {}),
            } for ex in pairs],
        }
        print(json.dumps(data, indent=2))
        return
    color = sys.stdout.isatty() and not args.no_color
    header = _terminal_safe(f"# {s.harness}:{s.session_id}  ({s.project or '?'})")
    print(header)
    print(render_session(s, args.mode, args.n, color))


def cmd_grep(args):
    if args.limit < 1:
        sys.exit("convo: --limit must be at least 1")
    since = parse_since(args.since)
    harnesses = resolve_harnesses(args.harness)
    proj = None if args.all_projects else (args.project or None)
    candidates = discover(harnesses, proj, since, args.limit, per_harness=True)
    errors: list[str] = []
    sessions = load_sessions(candidates, proj, errors)
    sessions.sort(key=lambda s: s.mtime, reverse=True)

    flags = 0 if args.case_sensitive else re.IGNORECASE
    try:
        pat = re.compile(args.pattern, flags)
    except re.error as e:
        sys.exit(f"convo: bad pattern: {e}")

    hits = []
    for s in sessions:
        for ti, t in enumerate(s.turns):
            if pat.search(t.text):
                hits.append((s, ti, t))
    if args.json:
        print(json.dumps([{
            "harness": s.harness, "session_id": s.session_id, "path": s.path,
            "role": t.role, "ts": t.ts, "text": t.text,
        } for s, _, t in hits], indent=2))
        for error in errors:
            print(f"convo: corrupt/unreadable session skipped: {error}", file=sys.stderr)
        if errors:
            sys.exit(2)
        return
    if not hits:
        for error in errors:
            print(f"convo: corrupt/unreadable session skipped: {error}", file=sys.stderr)
        if errors:
            sys.exit(2)
        # grep convention: no match is exit 1 (not an error, just nothing found).
        print("convo: no matches.", file=sys.stderr)
        sys.exit(1)
    color = sys.stdout.isatty() and not args.no_color
    for s, ti, t in hits:
        badge = {"claude": "CC", "codex": "CX", "gemini": "GM", "qwen": "QW"}.get(s.harness, s.harness)
        loc = f"{badge}:{s.session_id[:12]} {_short_ts(t.ts)} [{t.role}]"
        snippet = _terminal_safe(" ".join(t.text.split()))
        # highlight match
        if color:
            snippet = pat.sub(lambda m: f"\033[1;33m{m.group(0)}\033[0m", snippet)
            loc = f"\033[2;36m{loc}\033[0m"
        # show a window around the first match
        m = pat.search(t.text)
        idx = m.start() if m else 0
        flat = " ".join(t.text.split())
        # recompute idx in flattened space approximately
        start = max(0, flat.lower().find(args.pattern.lower()) - 60) if not args.case_sensitive else max(0, flat.find(args.pattern) - 60)
        window = flat[start:start + 200]
        if color:
            window = pat.sub(lambda mm: f"\033[1;33m{mm.group(0)}\033[0m", window)
        print(f"{loc}\n    …{window}…\n")
    for error in errors:
        print(f"convo: corrupt/unreadable session skipped: {error}", file=sys.stderr)
    if errors:
        sys.exit(2)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="convo",
        description="Read agent conversation history across Claude Code, Codex, Gemini CLI, and Qwen Code.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap_epilog(),
    )
    sub = p.add_subparsers(dest="cmd")

    def common(sp):
        sp.add_argument("--harness", help="claude|codex|gemini|qwen|all (or cc,cx,gm,qw). Default: all")
        sp.add_argument("--project", help="substring filter on project/cwd (default: current dir)")
        sp.add_argument("--all-projects", action="store_true", help="don't filter by current dir")
        sp.add_argument("--since", help="time window: 7d, 24h, 30m, 2w, or ISO date")
        sp.add_argument("--json", action="store_true", help="emit JSON")
        sp.add_argument("--no-color", action="store_true", help="disable ANSI color")

    sp_list = sub.add_parser("list", help="list recent sessions (default command)")
    common(sp_list)
    sp_list.add_argument("--limit", type=int, default=20, help="max sessions (default 20)")
    sp_list.set_defaults(func=cmd_list)

    sp_show = sub.add_parser("show", help="print a session's clean transcript")
    common(sp_show)
    sp_show.add_argument("session", nargs="?", help="session id (substring) or path; default: most recent")
    sp_show.add_argument("--mode", choices=["final", "text", "full"], default="final",
                         help="final=user+last reply (default); text=all agent text; full=+tools")
    sp_show.add_argument("-n", type=int, default=None,
                         help="only the last N exchanges (N<1 or omitted = all)")
    sp_show.set_defaults(func=cmd_show)

    sp_grep = sub.add_parser("grep", help="search across sessions")
    common(sp_grep)
    sp_grep.add_argument("pattern", help="regex to search in turn text")
    sp_grep.add_argument("--limit", type=int, default=100,
                         help="max sessions to scan per selected harness")
    sp_grep.add_argument("--case-sensitive", action="store_true",
                         help="case-sensitive match (default: case-insensitive)")
    # Accept grep's reflexive -i/--ignore-case as a friendly no-op (we're already
    # case-insensitive by default) so muscle memory doesn't hit an argparse error.
    sp_grep.add_argument("-i", "--ignore-case", action="store_true",
                         help=argparse.SUPPRESS)
    sp_grep.set_defaults(func=cmd_grep)

    # These are deliberately additive. The legacy commands above remain direct/raw
    # readers in this increment; only these commands open the durable local ledger.
    sp_sync = sub.add_parser("sync", help="incrementally refresh the durable local ledger")
    sp_sync.add_argument("--json", action="store_true", help="emit a versioned JSON result")
    sp_sync.add_argument("--verbose", action="store_true", help="print one diagnostic per partial source")
    sp_sync.set_defaults(func=cmd_sync)

    sp_status = sub.add_parser("status", help="show local ledger source and parser health")
    sp_status.add_argument("--json", action="store_true", help="emit a versioned JSON result")
    sp_status.set_defaults(func=cmd_status)

    sp_search = sub.add_parser("search", help="rank retained user/assistant messages with FTS")
    sp_search.add_argument("query", help="ordinary words to search (FTS syntax is treated literally)")
    sp_search.add_argument("--limit", type=int, default=20, help="max ranked messages (default 20)")
    sp_search.add_argument("--context", type=int, default=1, help="messages on each side (default 1, max 5)")
    sp_search.add_argument("--json", action="store_true", help="emit a versioned JSON result")
    sp_search.set_defaults(func=cmd_search)

    return p


def textwrap_epilog() -> str:
    return (
        "examples:\n"
        "  convo                         # recent sessions in the current project (all harnesses)\n"
        "  convo list --all-projects --since 3d\n"
        "  convo show                    # clean transcript of the most recent session here\n"
        "  convo show -n 20              # just the last 20 exchanges (user + agent's final reply)\n"
        "  convo show <id> --mode full   # full debug view with tool calls\n"
        "  convo show <id> --json        # structured exchanges for an agent to consume\n"
        "  convo grep 'god files' --all-projects --since 30d\n"
        "  convo sync                     # incrementally capture current raw logs\n"
        "  convo search 'SQLite ledger'   # ranked retained message search\n"
        "  convo status                   # source, retention, and parser health\n"
        "\nThe default 'final' mode shows each of your prompts paired with ONLY the agent's last\n"
        "text reply before your next prompt — tool calls and noise stripped. That's the clean\n"
        "transcript that's usually most useful when reviewing 'what did we actually say'.\n"
        "\nState boundary: list, show, and grep remain stateless direct/raw readers in this\n"
        "increment. Only sync, status, and search use the local SQLite ledger.\n"
        "sync streams Claude, Codex, and Qwen JSONL; Gemini documents retain the configurable\n"
        "64 MiB whole-document cap. Use --verbose for individual diagnostics.\n"
    )


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    parser = build_parser()

    # Let -h/--help and a bare subcommand reach the top-level parser directly.
    subcommands = {"list", "show", "grep", "sync", "status", "search"}
    if argv and (argv[0] in ("-h", "--help") or argv[0] in subcommands):
        args = parser.parse_args(argv)
    elif not argv:
        # bare `convo` → list
        args = parser.parse_args(["list"])
    else:
        # leading flags with no subcommand (e.g. `convo --since 3d`) → treat as `list`
        args = parser.parse_args(["list"] + argv)

    if not getattr(args, "func", None):
        parser.print_help()
        return

    # --project and --all-projects are contradictory. Don't guess — fail clearly.
    # (Was order/cache-dependent: sometimes the filter applied, sometimes not.)
    if getattr(args, "all_projects", False) and getattr(args, "project", None) is not None:
        sys.exit("convo: --project and --all-projects are mutually exclusive "
                 "(use --project to scope to one, --all-projects for everything)")

    # Default --project to current dir unless --all-projects/--project given.
    if getattr(args, "project", None) is None and not getattr(args, "all_projects", False):
        args.project = default_project_slug()

    try:
        args.func(args)
    except ValueError as e:  # e.g. an invalid --since value, surfaced cleanly
        sys.exit(f"convo: {e}")


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
    except KeyboardInterrupt:
        sys.exit(130)
